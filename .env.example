# .env.example — Multi-Project Admin System
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values
# Run: cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
APP_NAME=MultiProject
APP_URL=http://localhost:5000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_64_chars_change_in_production_NOW
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_min_64_chars_change_NOW
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS (comma-separated allowed origins) ────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5180

# ─────────────────────────────────────────────────────────────────────────────
# DATABASES (Prisma URL format — must match names in prisma/*/schema.prisma)
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
# ─────────────────────────────────────────────────────────────────────────────
HUB_DATABASE_URL=mysql://hub_user:Hub@Secure2024!@127.0.0.1:3306/hub_db?connection_limit=8
GAME_DATABASE_URL=mysql://game_user:Game@Secure2024!@127.0.0.1:3306/game_db?connection_limit=15
TRADE_DATABASE_URL=mysql://trade_user:Trade@Secure2024!@127.0.0.1:3306/trade_db?connection_limit=8
DATING_DATABASE_URL=mysql://dating_user:Dating@Secure2024!@127.0.0.1:3306/dating_db?connection_limit=8
SPORTS_DATABASE_URL=mysql://sports_user:Sports@Secure2024!@127.0.0.1:3306/sports_db?connection_limit=8
ADMIN_DATABASE_URL=mysql://admin_user:Admin@Secure2024!@127.0.0.1:3306/admin_db?connection_limit=15

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
CDN_BASE_URL=http://localhost:5000/uploads

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@example.com

# ── SMS ───────────────────────────────────────────────────────────────────────
# Provider: 'twilio' | 'console' (default: console in dev)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── AI Services ───────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_TRANSLATE_KEY=

# ── WebRTC / TURN ─────────────────────────────────────────────────────────────
TURN_SERVER=turn:your.turn.server:3478
TURN_USER=turnuser
TURN_CRED=turnpass

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENT GATEWAYS
# ─────────────────────────────────────────────────────────────────────────────

# ── MoMo (Vietnam) ────────────────────────────────────────────────────────────
MOMO_PARTNER_CODE=MOMOBKUN20180529
MOMO_ACCESS_KEY=klm05TvNBzhg7h7j
MOMO_SECRET_KEY=at67qH6mk8w5Y1nAyMoTp1awp+8FIg==
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5000/payment/momo/return
MOMO_IPN_URL=http://localhost:5000/api/lkvip/webhooks/momo

# ── ZaloPay (Vietnam) ─────────────────────────────────────────────────────────
ZALOPAY_APP_ID=2553
ZALOPAY_KEY1=PcY4iZIKFCIdgZvA6ueMcMHHUbRLYjPL
ZALOPAY_KEY2=kLtgPl8HHhfvMuDHPwKfgfsY4Yd2uPZm
ZALOPAY_REDIRECT_URL=http://localhost:5000/payment/zalopay/return

# ── VNPay (Vietnam) ───────────────────────────────────────────────────────────
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# GAME PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────

# ── GSC Plus (JILI / PG / PP / JDB / CQ9 / FC / KA) ──────────────────────────
GSC_API_KEY=
GSC_SECRET_KEY=
GSC_BASE_URL=https://api.gscplus.com
GSC_LOBBY_URL=http://localhost:5177
GSC_DEPOSIT_URL=http://localhost:5177/wallet
GSC_LANGUAGE=vi
GSC_CURRENCY=VND

# ── Goldgate (EVO Live / Sexy Baccarat / AG) ──────────────────────────────────
GOLDGATE_CLIENT_ID=
GOLDGATE_CLIENT_SECRET=
GOLDGATE_BASE_URL=https://api.goldgate.io
GOLDGATE_LOBBY_URL=http://localhost:5177

# ── TC Gaming (Lottery / Keno / Sports) ───────────────────────────────────────
TCGAMING_MERCHANT_CODE=
TCGAMING_DES_KEY=
TCGAMING_HASH_KEY=
TCGAMING_API_URL=https://api.tcgaming.net
TCGAMING_CURRENCY=VND2
TCGAMING_WALLET_TYPE=transfer

# ─────────────────────────────────────────────────────────────────────────────
# INTERNAL PAYMENT GATEWAY (LKvip)
# ─────────────────────────────────────────────────────────────────────────────
LKVIP_WEBHOOK_SECRET=change_me_webhook_secret_32chars

# ─────────────────────────────────────────────────────────────────────────────
# VIETQR (Bank QR codes for VA deposits)
# ─────────────────────────────────────────────────────────────────────────────
VIETQR_CLIENT_ID=
VIETQR_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_me_generate_64_hex_chars_with_crypto_randomBytes_32
OTP_EXPIRE_MINUTES=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

# ── Admin defaults (used by seed script) ──────────────────────────────────────
ADMIN_DEFAULT_EMAIL=admin@admin.com
ADMIN_DEFAULT_PASSWORD=Admin@123456

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_AI=false
ENABLE_2FA=false
ENABLE_QUEUE=false
MAINTENANCE_MODE=false
# Set to true to enable real-time price feed cron
ENABLE_PRICE_FEED=false

# ── Trade: Price Feed ─────────────────────────────────────────────────────────
# CoinGecko public API (no key required for basic plan)
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# Alpha Vantage API key — free at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── Sports: External Score Provider (optional) ────────────────────────────────
# Football-Data.org API — free tier at https://www.football-data.org/
FOOTBALL_DATA_API_KEY=
# Sportmonks API — https://www.sportmonks.com/
SPORTMONKS_API_TOKEN=
