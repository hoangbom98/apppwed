# ─────────────────────────────────────────────────────────────────────────────
# Staging environment — copy to .env.staging and fill real values
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=staging
PORT=5000

# ── Database URLs ─────────────────────────────────────────────────────────────
HUB_DATABASE_URL=mysql://user:pass@staging-db:3306/hub_db
GAME_DATABASE_URL=mysql://user:pass@staging-db:3306/game_db
TRADE_DATABASE_URL=mysql://user:pass@staging-db:3306/trade_db
DATING_DATABASE_URL=mysql://user:pass@staging-db:3306/dating_db
SPORTS_DATABASE_URL=mysql://user:pass@staging-db:3306/sports_db
ADMIN_DATABASE_URL=mysql://user:pass@staging-db:3306/admin_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://staging-redis:6379

# ── JWT (min 32 chars each) ───────────────────────────────────────────────────
JWT_SECRET=staging-jwt-secret-change-me-32chars
JWT_REFRESH_SECRET=staging-refresh-secret-change-me-32chars

# ── Encryption (AES-256 — exactly 32 chars) ──────────────────────────────────
ENCRYPTION_KEY=staging-encryption-key-32-chars!

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://staging.lkvip.com,https://game-staging.lkvip.com,https://admin-staging.lkvip.com

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx

# ── Frontend Sentry (Vite build-time) ────────────────────────────────────────
VITE_SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
VITE_APP_ENV=staging

# ── Metrics ───────────────────────────────────────────────────────────────────
METRICS_API_KEY=staging-metrics-key

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=xxxx:xxxxx
TELEGRAM_CHAT_ID=@lkvip_staging
# Alias used by health-check.ts and backup.sh
TELEGRAM_ALERT_CHAT_ID=-100xxxxxxxxxx

# ── Email (SMTP — use Mailtrap/Mailhog for staging) ──────────────────────────
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=staging-user
SMTP_PASS=staging-pass
SMTP_FROM=noreply@staging.lkvip.com

# ── Storage (Cloudflare R2 / S3 — use a staging bucket) ──────────────────────
STORAGE_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=staging-access-key
STORAGE_SECRET_KEY=staging-secret-key
STORAGE_BUCKET=lkvip-staging

# ── API Keys (sandbox / mock) ─────────────────────────────────────────────────
GSC_API_KEY=sandbox-gsc-key
GOLDGATE_API_KEY=sandbox-goldgate-key
TCGAMING_API_KEY=sandbox-tcgaming-key

# ── Misc ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
SEED_FORCE=false

# ── Vite frontend (build-time) ────────────────────────────────────────────────
VITE_API_URL=https://api.staging.lkvip.com
