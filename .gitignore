# ============================================================
# Root .gitignore — LKVIP GROUP
# Workspace root: /var/LKVIP/
# ============================================================

# --- Node.js dependencies ---
node_modules/
**/node_modules/

# --- Build outputs ---
dist/
build/
**/dist/
**/build/
.next/
.nuxt/
.output/
*.tsbuildinfo

# --- Environment / Secrets (NEVER commit real .env) ---
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
!.env.example
!**/.env.example

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log
**/logs/*.log

# --- Runtime data (logs, uploads, backups) ---
/data/
apps/backend/backups/
apps/backend/uploads/

# --- Prisma generated clients ---
apps/backend/node_modules/.prisma/

# --- OS / Editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sw?
*.swp
*.swo

# --- Temp / Cache ---
*.tmp
*.cache
*.pid
.deploy_rollback
.turbo/
.cache/

# --- Archives ---
_archive/
docs/legacy/

# --- Old / reference codebases (not part of active build) ---
trading-old/

# --- Auto-generated HTML reports ---
*-codebase-overview.html
*-architecture-report.html

# --- Obsolete plan/draft files (auto-generated, do not commit) ---
*-plan.md
*-cleanup-plan.md
*-guide-draft.md

# --- Capacitor / Mobile (apps/mobile — Capacitor wrapper) ---
android/
ios/

# --- Android Native (apps/mobile-native — Kotlin) ---
apps/mobile-native/.gradle/
apps/mobile-native/local.properties
apps/mobile-native/app/build/
apps/mobile-native/captures/
apps/mobile-native/.cxx/
apps/mobile-native/.externalNativeBuild/
apps/mobile-native/*.jks
apps/mobile-native/*.keystore
apps/mobile-native/keystore.properties

# --- Large media files ---
apps/hub/public/assets/videos/

# --- pnpm store (nằm ngoài repo — không commit) ---
.pnpm-store/

# --- Vite shared transform cache (monorepo) ---
node_modules/.vite-cache/

.gemini/
gha-creds-*.json

# --- AI tool configs (contain tokens/API keys — never commit) ---
.codex/
.claude/
.claude.json
*_credentials_*.txt
router-config-*.zip
