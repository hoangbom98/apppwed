# LKVIP Platform — pnpm configuration
#
# node-linker=hoisted: cần thiết để Capacitor native builds (Android/iOS Gradle + Xcode)
# có thể traverse node_modules mà không gặp vấn đề với symlinks.
node-linker=hoisted

# Chỉ hoist các packages thực sự cần thiết ở root để tránh flatten thừa.
# "*" hoist tất cả — giữ nguyên để đảm bảo Capacitor + Prisma hoạt động đúng.
public-hoist-pattern[]=*

# Prevent accidental npm/yarn installs in this workspace
engine-strict=false

# Allow build scripts for required dependencies
only-built-dependencies=@firebase/util,@prisma/client,@prisma/engines,@scarf/scarf,core-js,esbuild,msgpackr-extract,prisma,protobufjs,sharp

# !! store-dir ĐÃ BỎ — pnpm dùng global store mặc định (~/.local/share/pnpm/store)
# Điều này ngăn 2.3 GB pnpm store nằm trong repo và tính vào disk quota project.
