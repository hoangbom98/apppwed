{
  "name": "@lkvip/__APPNAME__",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev":       "vite --port __PORT__",
    "build":     "tsc -b && vite build",
    "preview":   "vite preview --port __PORT__",
    "lint":      "oxlint src",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "cap:build": "cross-env CAPACITOR_BUILD=true tsc -b && cross-env CAPACITOR_BUILD=true vite build",
    "cap:sync":  "npm run cap:build && npx cap sync"
  },
  "dependencies": {
    "@lkvip/ui":             "workspace:*",
    "@lkvip/types":          "workspace:*",
    "@tanstack/react-query": "catalog:",
    "axios":                 "catalog:",
    "lucide-react":          "catalog:",
    "react":                 "catalog:",
    "react-dom":             "catalog:",
    "react-hot-toast":       "catalog:",
    "react-router-dom":      "catalog:",
    "yup":                   "catalog:",
    "zustand":               "catalog:"
  },
  "devDependencies": {
    "@types/node":          "catalog:",
    "@types/react":         "catalog:",
    "@types/react-dom":     "catalog:",
    "@tailwindcss/vite":    "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "autoprefixer":         "catalog:",
    "cross-env":            "catalog:",
    "oxlint":               "catalog:",
    "postcss":              "catalog:",
    "tailwindcss":          "catalog:",
    "typescript":           "catalog:",
    "vite":                 "catalog:",
    "vite-plugin-pwa":      "^1.3.0"
  }
}
