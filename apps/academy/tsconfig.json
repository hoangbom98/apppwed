{
  "extends": "../../tsconfig.frontend.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*":            ["./src/*"],
      "@ui":            ["../../packages/ui/src/index.ts"],
      "@ui/*":          ["../../packages/ui/src/*"],
      "@lkvip/types":   ["../../packages/types/src/index.ts"],
      "@lkvip/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "css.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
