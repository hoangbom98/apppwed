# ─────────────────────────────────────────────────────────────────────────────
# .env.example — @lkvip/admin (Vite + React + Ant Design)
# Copy to .env:  cp .env.example .env   then fill every value.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL of the backend API + Socket.IO server.
# Used by vite.config.ts proxy target (process.env.VITE_API_URL).
VITE_API_URL=http://localhost:5000

# ── Application ───────────────────────────────────────────────────────────────
VITE_APP_NAME=LKVIP Admin
VITE_APP_ENV=development
