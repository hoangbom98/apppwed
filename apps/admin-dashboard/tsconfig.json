{
  "extends": "../../tsconfig.frontend.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*":      ["./src/*"],
      "@admin/*": ["./src/*"],
      "@ui":      ["../../packages/ui/src/index.ts"],
      "@ui/*":    ["../../packages/ui/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/test", "src/__tests__", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.spec.ts", "src/**/*.spec.tsx"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
