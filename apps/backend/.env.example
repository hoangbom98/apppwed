# ─────────────────────────────────────────────────────────────────────────────
# .env.example — LKVIP GROUP Backend (VPS Production)
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env:  cp .env.example .env
# Then fill in all values before running first-deploy.sh
#
# All services run locally on the VPS:
#   MySQL  → localhost:3306  (installed by setup.sh)
#   Redis  → localhost:6379  (installed by setup.sh)
#   Nginx  → port 80/443     (installed by setup.sh)
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=info
APP_NAME=LKVIP-GROUP
# Your API subdomain (used for webhook URLs, email links, etc.)
APP_URL=https://api.yourdomain.com

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_run_node_crypto_randomBytes_48_hex
JWT_REFRESH_SECRET=CHANGE_ME_run_node_crypto_randomBytes_48_hex_different
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS — list all frontend subdomains ───────────────────────────────────────
CORS_ORIGINS=https://hub.yourdomain.com,https://game.yourdomain.com,https://trade.yourdomain.com,https://dating.yourdomain.com,https://sports.yourdomain.com,https://admin.yourdomain.com

# ── Metrics endpoint protection ───────────────────────────────────────────────
# Protect /metrics (Prometheus scrape) with an API key.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Set in Prometheus scrape config: bearer_token or params: [key: [value]]
# Leave empty to allow public access (not recommended for production).
METRICS_API_KEY=CHANGE_ME_48_random_hex_chars

# ── Monitoring configurations ────────────────────────────────────────────────
MONITOR_DOMAIN=tc-gaming.live
MONITOR_VPS_IP=104.248.146.203

# ── Error tracking (Sentry) ───────────────────────────────────────────────────
# Optional: create free project at https://sentry.io
# Set to enable real-time error tracking and performance monitoring
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# DATABASES — local MySQL 8 (setup.sh creates these)
# Credentials auto-generated by setup.sh → saved in CREDENTIALS.txt
#
# Connection pool sizing formula:
#   connection_limit = floor( (max_connections * 0.8) / (pm2_instances * 6) )
#
# VPS cores → pool size per DB (assuming MySQL max_connections=500):
#   2 cores  (2 workers)  → ?connection_limit=33
#   4 cores  (4 workers)  → ?connection_limit=16
#   8 cores  (8 workers)  → ?connection_limit=8   ← recommended
#   16 cores (16 workers) → ?connection_limit=4
#
# Example for 8-core VPS (8 PM2 workers × 6 DBs × 8 = 384 < 500*0.8=400):
# ─────────────────────────────────────────────────────────────────────────────
HUB_DATABASE_URL=mysql://lkvip_db:CHANGE_ME@127.0.0.1:3306/hub_db?connection_limit=8
GAME_DATABASE_URL=mysql://lkvip_db:CHANGE_ME@127.0.0.1:3306/game_db?connection_limit=8
TRADE_DATABASE_URL=mysql://lkvip_db:CHANGE_ME@127.0.0.1:3306/trade_db?connection_limit=8
DATING_DATABASE_URL=mysql://lkvip_db:CHANGE_ME@127.0.0.1:3306/dating_db?connection_limit=8
SPORTS_DATABASE_URL=mysql://lkvip_db:CHANGE_ME@127.0.0.1:3306/sports_db?connection_limit=8
ADMIN_DATABASE_URL=mysql://lkvip_db:CHANGE_ME@127.0.0.1:3306/admin_db?connection_limit=8

# ── Redis — local Redis 7 ─────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/var/www/lkvip-platform/data/uploads
LOG_PATH=/var/www/lkvip-platform/data/logs
MAX_FILE_SIZE_MB=10
CDN_BASE_URL=https://api.yourdomain.com/uploads
# Storage provider: 'local' (default) | 's3' (AWS S3 / Cloudflare R2 / MinIO) | 'supabase'
STORAGE_PROVIDER=local
# Required when STORAGE_PROVIDER=s3:
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: custom S3 endpoint (Cloudflare R2, MinIO, etc.)
S3_ENDPOINT=

# ── Supabase Auth + Storage ───────────────────────────────────────────────────
# Only used for:
#   1. Supabase Auth JWT verification (authenticateSupabase middleware)
#   2. Supabase Storage file uploads (STORAGE_PROVIDER=supabase)
# All 6 MySQL databases remain unchanged on VPS — no data migration needed.
#
# Get values from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=
# anon/public key — safe for client-side, used only to verify user JWTs
SUPABASE_ANON_KEY=
# service_role key — server-only, bypasses Row-Level Security. KEEP SECRET.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket name in Supabase Storage (create manually in dashboard → Storage)
# Only needed when STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=lkvip-uploads

# ── Email ─────────────────────────────────────────────────────────────────────
# Option A: Gmail OAuth2 (recommended for production — never blocked by Google)
#   Step 1: Create OAuth2 credentials at https://console.cloud.google.com
#   Step 2: Get refresh token via OAuth Playground: https://developers.google.com/oauthplayground
#   Step 3: Fill the 3 vars below. SMTP_FROM must be the Gmail address.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SMTP_FROM=your@gmail.com

# Option B: SMTP generic (Mailtrap dev, SendGrid, SES, etc.)
# When GOOGLE_CLIENT_ID is set, Option A takes priority and these are ignored for email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# ── Social OAuth (Google & Facebook login) ─────────────────────────────────────
# Google OAuth2 — same credentials as email OAuth2 above (re-used)
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET already set above
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback

# Facebook App — create at https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api.yourdomain.com/api/auth/facebook/callback

# Frontend redirect URL after OAuth success/failure
# e.g. https://hub.yourdomain.com/auth/callback
OAUTH_REDIRECT_URL=https://hub.yourdomain.com/auth/callback

# ── SMS ───────────────────────────────────────────────────────────────────────
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── AI Services ───────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_TRANSLATE_KEY=

# ── Groq AI — fraud detection + CSKH fallback (free: 30 req/min) ─────────────
# Get key: https://console.groq.com
GROQ_API_KEY=
# Model slug — default llama-3.3-70b-versatile (fastest free model)
GROQ_MODEL=llama-3.3-70b-versatile

# ── WebRTC / TURN ─────────────────────────────────────────────────────────────
TURN_SERVER=turn:yourdomain.com:3478
TURN_USER=turnuser
TURN_CRED=CHANGE_ME

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars
OTP_EXPIRE_MINUTES=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── API Payload Encryption (AES-256-GCM) ──────────────────────────────────────
# 64-char hex (32 bytes) key for AES-256-GCM request payload decryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used by aesEncryption.middleware.ts — replaces insecure AES-128-ECB
# OWASP A04:2025 compliant — ECB mode removed.
API_AES_KEY=CHANGE_ME_64_hex_chars_for_aes_256_gcm

# ── Password Policy (NIST SP 800-63B) ─────────────────────────────────────────
# Minimum password length. NIST recommends 8 minimum, 12+ encouraged.
# PCI DSS 4.0 req 8.3.6 mandates minimum 12 chars for new deployments (2025+).
PASSWORD_MIN_LENGTH=8
# Enable HaveIBeenPwned breach check on registration/password-change (free API).
# Set to true to block passwords found in known data breaches.
# The check uses k-anonymity (SHA-1 prefix) — the full password is NEVER sent.
# NIST SP 800-63B §5.1.1 compliant. Adds ~300ms latency on first registration.
HIBP_ENABLED=false

# ── AbuseIPDB — block bot/VPN IPs in auth middleware (1000 req/day free) ─────
# Get key: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# Block IPs with abuse confidence score ≥ this threshold (0-100, default 50)
ABUSEIPDB_THRESHOLD=50

# ── Telegram Bot — realtime admin alerts (free, no rate limit) ───────────────
# 1. Chat @BotFather → /newbot → copy token below
# 2. curl https://api.telegram.org/bot<TOKEN>/getUpdates to get chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── Perspective API — auto-moderation chat/comments ──────────────────────────
# Get key: https://console.cloud.google.com → Enable "Perspective Comment Analyzer API"
PERSPECTIVE_API_KEY=
# Block content with toxicity score ≥ threshold (0-1, default 0.8)
PERSPECTIVE_THRESHOLD=0.8

# ── Dicebear Avatars — default avatar generation (free, no key needed) ───────
# Base URL (change to self-hosted instance if needed)
DICEBEAR_BASE_URL=https://api.dicebear.com/7.x
# Output format: svg (default, smallest) or png
DICEBEAR_FORMAT=svg

# ── ipapi.co — geo analytics from IP (1000 req/day free, no key needed) ──────
# No configuration needed — service auto-detects and caches results.
# Optional: upgrade to paid plan for higher quota, then set key in ipGuardService.ts

# ── Open-Meteo — stadium weather (free, no key needed) ───────────────────────
# No configuration needed — open API, no auth required.

# ── Backup (used by backup.sh cron) ───────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=lkvip_db
DB_PASSWORD=CHANGE_ME

# ── Admin seed defaults ───────────────────────────────────────────────────────
ADMIN_DEFAULT_EMAIL=admin@lkvip.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_strong_password

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENT GATEWAYS (Vietnam)
# ─────────────────────────────────────────────────────────────────────────────

# ── MoMo ─────────────────────────────────────────────────────────────────────
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://api.yourdomain.com/payment/momo/return
MOMO_IPN_URL=https://api.yourdomain.com/api/lkvip/webhooks/momo

# ── ZaloPay ───────────────────────────────────────────────────────────────────
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_REDIRECT_URL=https://api.yourdomain.com/payment/zalopay/return

# ── VNPay ─────────────────────────────────────────────────────────────────────
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# GAME PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────
GSC_API_KEY=
GSC_SECRET_KEY=
GSC_BASE_URL=https://api.gscplus.com
GSC_LOBBY_URL=https://game.yourdomain.com
GSC_DEPOSIT_URL=https://game.yourdomain.com/wallet
GSC_LANGUAGE=vi
GSC_CURRENCY=VND

GOLDGATE_CLIENT_ID=
GOLDGATE_CLIENT_SECRET=
GOLDGATE_BASE_URL=https://api.goldgate.io
GOLDGATE_LOBBY_URL=https://game.yourdomain.com

TCGAMING_MERCHANT_CODE=
TCGAMING_DES_KEY=
TCGAMING_HASH_KEY=
TCGAMING_API_URL=https://api.tcgaming.net
TCGAMING_CURRENCY=VND2
TCGAMING_WALLET_TYPE=transfer

# ── Internal LKvip ────────────────────────────────────────────────────────────
LKVIP_WEBHOOK_SECRET=CHANGE_ME_32_random_chars

# ── VietQR ────────────────────────────────────────────────────────────────────
VIETQR_CLIENT_ID=
VIETQR_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_AI=false
ENABLE_2FA=false
ENABLE_QUEUE=false
MAINTENANCE_MODE=false

# ── Firebase Cloud Messaging (FCM) — Push Notifications ─────────────────────
# Option A: Place firebase-service-account.json next to package.json (auto-detected)
# Option B: Paste the entire JSON as a single-line string below
# Get from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Leave empty to disable push notifications (no error, graceful no-op)
FIREBASE_SERVICE_ACCOUNT=

# ── Web Push / PWA ────────────────────────────────────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
# Then set VAPID_SUBJECT to a mailto: or https: URL for your domain
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
# Set to true to enable real-time price feed cron (requires COINGECKO_API_URL)
ENABLE_PRICE_FEED=false

# ── Trade: Price Feed ─────────────────────────────────────────────────────────
# CoinGecko public API — no key required for free tier (10,000 req/month)
# Primary source: Binance (no key). CoinGecko is the automatic fallback.
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# Optional: CoinGecko Pro API key for higher rate limits
# Get key: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=
# Alpha Vantage API key — free at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── Game: Robot liquidity simulation ─────────────────────────────────────────
# Set ENABLE_ROBOT_BETS=true to have robot accounts auto-bet on open lottery draws.
# cron.ts fires every 30s; each tick enqueues 1 bet per active robot account.
ENABLE_ROBOT_BETS=false
# Interval (ms) between robot bet scheduler ticks — default 30000 (30s)
ROBOT_BET_INTERVAL_MS=30000

# ── Sports: OpenF1 — F1 realtime data (free, no key needed) ──────────────────
# No configuration needed — open API at https://openf1.org
# Live data cached 30s, session info cached 1h to avoid hammering the API.

# ── Sports: External Score Provider (optional — stub used when not set) ────────
# API-Football (RapidAPI) — primary live scores, fixtures, standings
# Get key: https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=
# Also used directly via api-sports.io header:
API_FOOTBALL_KEY=

# GNews API — sports news headlines (vi language)
# Free tier: https://gnews.io/
GNEWS_API_KEY=

# TheSportsDB — fallback team/league metadata & highlights
# Free: https://www.thesportsdb.com/api.php
THESPORTSDB_API_KEY=

# Legacy providers (still accepted by ServiceRegistry if set):
# Football-Data.org API — free tier at https://www.football-data.org/
FOOTBALL_DATA_API_KEY=
# Sportmonks API — https://www.sportmonks.com/
SPORTMONKS_API_TOKEN=

# Leagues to track (comma-sep API-Football IDs, default: 39,140,78,135,61,340,2)
# 39=EPL 140=LaLiga 78=Bundesliga 135=SerieA 61=Ligue1 340=VLeague 2=UCL
SPORTS_LEAGUES=39,140,78,135,61,340,2
# Season to sync standings for (default: current year)
SPORTS_SEASON=2024

# ─────────────────────────────────────────────────────────────────────────────
# COLD STORAGE / ARCHIVE (Tầng 2)
# ─────────────────────────────────────────────────────────────────────────────
# Set ARCHIVE_ENABLED=true to activate monthly cron archive job
ARCHIVE_ENABLED=false
# S3-compatible bucket name (Cloudflare R2 recommended — free 10GB egress)
ARCHIVE_BUCKET=
# Cloudflare R2 endpoint: https://<account_id>.r2.cloudflarestorage.com
# AWS S3: leave empty (uses default)
# Backblaze B2: https://s3.us-west-004.backblazeb2.com
ARCHIVE_S3_ENDPOINT=
ARCHIVE_S3_REGION=auto
ARCHIVE_S3_ACCESS_KEY_ID=
ARCHIVE_S3_SECRET_ACCESS_KEY=
# Archive data older than N months (default: 6)
ARCHIVE_MONTHS=6
# Rows per batch during archive read (default: 1000)
ARCHIVE_BATCH_SIZE=1000

# ─────────────────────────────────────────────────────────────────────────────
# MONITORING (Tầng 8)
# ─────────────────────────────────────────────────────────────────────────────
# Protect /metrics endpoint with an API key (leave empty to allow public access)
METRICS_API_KEY=CHANGE_ME_32_random_chars
# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# READ REPLICA URLs (Tầng 1.3 — optional, falls back to master if not set)
# Setup guide: https://dev.mysql.com/doc/refman/8.0/en/replication.html
# ─────────────────────────────────────────────────────────────────────────────
# HUB_REPLICA_DATABASE_URL=mysql://reader:PASS@replica:3306/hub_db?connection_limit=5
# GAME_REPLICA_DATABASE_URL=mysql://reader:PASS@replica:3306/game_db?connection_limit=8
# TRADE_REPLICA_DATABASE_URL=mysql://reader:PASS@replica:3306/trade_db?connection_limit=5
# DATING_REPLICA_DATABASE_URL=mysql://reader:PASS@replica:3306/dating_db?connection_limit=5
# SPORTS_REPLICA_DATABASE_URL=mysql://reader:PASS@replica:3306/sports_db?connection_limit=5
# ADMIN_REPLICA_DATABASE_URL=mysql://reader:PASS@replica:3306/admin_db?connection_limit=5

# ─────────────────────────────────────────────────────────────────────────────
# SHARDING (Tầng 1.1 — disabled by default, enable when trade_db > 100M rows)
# ─────────────────────────────────────────────────────────────────────────────
# Set TRADE_SHARD_COUNT=4 to enable sharding, then add shard URLs below:
TRADE_SHARD_COUNT=0
# TRADE_DB_SHARD_0_URL=mysql://user:PASS@db0:3306/trade_db_shard_0
# TRADE_DB_SHARD_1_URL=mysql://user:PASS@db1:3306/trade_db_shard_1
# TRADE_DB_SHARD_2_URL=mysql://user:PASS@db2:3306/trade_db_shard_2
# TRADE_DB_SHARD_3_URL=mysql://user:PASS@db3:3306/trade_db_shard_3
