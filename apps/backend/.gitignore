# -- Runtime / Generated ------------------------------------------------------
node_modules/
dist/
.prisma/

# Prisma generated clients (regenerated on deploy via npm run prisma:generate)
node_modules/.prisma/

# -- Environment / Secrets ----------------------------------------------------
.env
.env.local
.env.*.local
# Keep .env.example committed
!.env.example

# -- Logs ---------------------------------------------------------------------
logs/
*.log
npm-debug.log*

# -- Uploads (user-generated content, served separately) ----------------------
uploads/
# Allow the directory placeholder to remain:
!uploads/.gitkeep

# -- OS / Editor --------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# -- Deployment artefacts -----------------------------------------------------
.deploy_rollback
*.pid
# -- Database backups (never commit) -----------------------------------------
backups/
