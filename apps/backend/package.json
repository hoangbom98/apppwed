{
  "name": "lkvip-backend",
  "version": "2.0.0",
  "description": "LKVIP GROUP � Multi-Project Backend API — Hub, Game, Trade, Dating, Sports, Admin",
  "main": "dist/server.js",
  "scripts": {
    "// ── Server ───────────────────────────────────────────────────────────────": "",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx server.ts",
    "build": "npx tsc",
    "// ── Prisma — tham số hóa ─────────────────────────────────────────────────": "",
    "// Usage: tsx scripts/prisma-run.ts <action> [module]                      ": "",
    "// e.g.:  tsx scripts/prisma-run.ts generate hub                           ": "",
    "prisma:run": "tsx scripts/prisma-run.ts",
    "prisma:generate": "tsx scripts/prisma-run.ts generate",
    "prisma:generate:hub": "tsx scripts/prisma-run.ts generate hub",
    "prisma:generate:game": "tsx scripts/prisma-run.ts generate game",
    "prisma:generate:trade": "tsx scripts/prisma-run.ts generate trade",
    "prisma:generate:dating": "tsx scripts/prisma-run.ts generate dating",
    "prisma:generate:sports": "tsx scripts/prisma-run.ts generate sports",
    "prisma:generate:admin": "tsx scripts/prisma-run.ts generate admin",
    "prisma:migrate:all": "tsx scripts/prisma-run.ts migrate",
    "prisma:deploy:all": "tsx scripts/prisma-run.ts deploy",
    "prisma:status:all": "tsx scripts/prisma-run.ts status",
    "// ── Seeds ────────────────────────────────────────────────────────────────": "",
    "seed": "tsx prisma/seeds/index.ts",
    "seed:all": "tsx prisma/seeds/index.ts",
    "seed:all:force": "cross-env SEED_FORCE=true tsx prisma/seeds/index.ts",
    "seed:admin": "tsx prisma/seeds/admin.seed.ts",
    "seed:hub": "tsx prisma/seeds/hub.seed.ts",
    "seed:game": "tsx prisma/seeds/game.seed.ts",
    "seed:dating": "tsx prisma/seeds/dating.seed.ts",
    "seed:sports": "tsx prisma/seeds/sports.seed.ts",
    "seed:lkvip": "tsx prisma/seeds/lkvip.seed.ts",
    "seed:trade": "tsx prisma/seeds/trade.seed.ts",
    "seed:payment": "tsx prisma/seeds/payment-gateways.seed.ts",
    "seed:flags": "tsx prisma/seeds/feature-flags.seed.ts",
    "seed:ui-config": "tsx prisma/seeds/ui-config.seed.ts",
    "seed:aggregators": "tsx prisma/seeds/gameAggregators.seed.ts",
    "seed:game-products": "tsx prisma/seeds/gameProducts.seed.ts",
    "seed:demo": "tsx prisma/seeds/demo.seed.ts",
    "seed:test-users": "tsx prisma/seeds/test-users.seed.ts",
    "storage:migrate": "tsx scripts/migrate-storage.ts",
    "// ── Lint / TypeCheck ─────────────────────────────────────────────────────": "",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint src --max-warnings 0",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=true eslint src --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lkvip/api-client": "workspace:^",
    "@lkvip/constants": "workspace:*",
    "@lkvip/utils": "workspace:*",
    "@sentry/node": "^8.0.0",
    "@supabase/server": "^1.4.1",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "bullmq": "^5.80.10",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^7.2.0",
    "i18next": "^23.16.8",
    "i18next-fs-backend": "^2.6.6",
    "i18next-http-middleware": "^3.9.7",
    "ioredis": "^5.11.1",
    "joi": "^17.13.4",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.23.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^5.0.3",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "^5.15.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^6.4.24",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.7",
    "jsdom": "^30.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^5.15.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
