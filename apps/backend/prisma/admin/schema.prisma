// ═══════════════════════════════════════════════════════════════════════════
// prisma/admin/schema.prisma  —  Admin & Shared Database  v2.1
// Database: admin_db  |  Charset: utf8mb4_unicode_ci
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/admin-client"
}

datasource db {
  provider = "mysql"
  url      = env("ADMIN_DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// ADMIN USERS
// ═══════════════════════════════════════════════════════════════════════════

model AdminUser {
  id          Int       @id @default(autoincrement())
  tenant      String    @default("admin") @db.VarChar(20)
  username    String    @unique @db.VarChar(100)
  email       String    @unique @db.VarChar(191)
  password    String    @db.VarChar(255)
  fullName    String    @db.VarChar(150)
  avatar      String?   @db.VarChar(500)
  role        String    @default("admin")    @db.VarChar(30)   // super_admin | admin | finance | support | manager | tech | marketing | kyc
  permissions Json?
  status      String    @default("active")   @db.VarChar(20)
  lastLogin   DateTime?
  twoFaSecret String?   @db.VarChar(64)
  twoFaEnabled Boolean  @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs        SystemLog[]
  assignedTasks OpsTask[]  @relation("AssignedTasks")
  adminRole   AdminRole?   @relation("AdminUserRole", fields: [roleId], references: [id])
  roleId      Int?

  @@index([tenant], map: "idx_tenant_config")
  @@index([status])
  @@index([role])
  @@index([roleId])
  @@map("admin_users")
}

// ═══════════════════════════════════════════════════════════════════════════
// SHARED USERS  (mirror — không chứa business data, chỉ identity + wallet)
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id              String    @id @default(cuid())
  tenant          String    @db.VarChar(20)
  email           String    @unique @db.VarChar(191)
  phone           String?   @unique @db.VarChar(20)
  password        String    @db.VarChar(255)
  fullName        String?   @db.VarChar(150)
  avatar          String?   @db.VarChar(500)
  status          String    @default("active")      @db.VarChar(20)   // active|suspended|banned
  role            String    @default("user")        @db.VarChar(30)   // user|admin|super_admin|agent
  kycLevel        String    @default("unverified")  @db.VarChar(20)   // unverified|basic|verified|enhanced
  riskScore       Int       @default(0)
  referrerId      String?   @db.VarChar(30)
  referralCode    String?   @unique @db.VarChar(30)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  wallets                 Wallet[]
  transactions            Transaction[]
  kycDocuments            KycDocument[]
  referrals               Referral[]             @relation("Referrer")
  referredBy              Referral[]             @relation("Referee")
  commissions             Commission[]
  notifications           Notification[]
  activities              UserActivity[]
  projectMembers          ProjectMember[]
  depositOrders           DepositOrder[]
  withdrawOrders          WithdrawOrder[]
  riskScores              RiskScore[]
  riskAlerts              RiskAlert[]
  loyaltyPoints           LoyaltyPoint[]
  loyaltyTransactions     LoyaltyTransaction[]
  rewardClaims            RewardClaim[]
  aiInteractions          AiInteraction[]
  notificationSetting     NotificationSetting?
  auditLogs               AuditLog[]
  userDevices             UserDevice[]
  amlAlerts               AmlAlert[]
  securityLogs            SecurityLog[]
  
  // 🔐 Security fields
  emailVerified           Boolean   @default(false)
  phoneVerified           Boolean   @default(false)
  twoFactorSecret         String?   @db.VarChar(255)
  twoFactorEnabled        Boolean   @default(false)
  lastPasswordChange      DateTime?
  passwordHistory         Json?
  loginAttempts           Int       @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  lastLoginIp             String?   @db.VarChar(45)

  loginLogs               LoginLog[]
  sessions                UserSession[]
  deviceFingerprints      DeviceFingerprint[]

  @@index([tenant], map: "idx_tenant_config")
  @@index([email])
  @@index([status])
  @@index([role])
  @@index([kycLevel])
  @@index([createdAt])
  @@index([referralCode])
  @@index([lockedUntil])
  @@map("users")
}

// ===== LOGIN LOG =====
model LoginLog {
  id          Int      @id @default(autoincrement())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  username    String   @db.VarChar(50)
  ip          String   @db.VarChar(45)
  userAgent   String?  @db.Text
  deviceId    String?  @db.VarChar(255)
  success     Boolean
  failReason  String?  @db.VarChar(100) // 'wrong_password', 'locked', 'captcha_required'
  createdAt   DateTime @default(now())

  @@index([username])
  @@index([ip])
  @@index([createdAt])
  @@index([success])
  @@map("login_logs")
}

// ===== USER SESSION =====
model UserSession {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique @db.VarChar(500)
  refreshToken String? @unique @db.VarChar(500)
  ip          String?  @db.VarChar(45)
  userAgent   String?  @db.Text
  deviceId    String?  @db.VarChar(255)
  expiresAt   DateTime
  refreshExpiresAt DateTime?
  isRevoked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ===== DEVICE FINGERPRINT =====
model DeviceFingerprint {
  id          String   @id @default(cuid())
  userId      String
  deviceId    String   @db.VarChar(255)
  ip          String?  @db.VarChar(45)
  userAgent   String?  @db.Text
  trustScore  Int      @default(0) // 0-100
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@map("device_fingerprints")
}

model ProjectMember {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  roleInProject String   @default("user")  @db.VarChar(30)
  joinedAt      DateTime @default(now())
  status        String   @default("active") @db.VarChar(20)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("project_members")
}

model Project {
  id          String   @id @default(cuid())
  code        String   @unique @db.VarChar(20)   // hub|game|trade|dating|sports
  name        String   @db.VarChar(100)
  description String?  @db.Text
  domain      String?  @db.VarChar(255)
  status      String   @default("active") @db.VarChar(20)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ProjectMember[]

  @@map("projects")
}

// ═══════════════════════════════════════════════════════════════════════════
// SYSTEM CONFIGURATION
// ═══════════════════════════════════════════════════════════════════════════

model SystemConfig {
  id          Int      @id @default(autoincrement())
  tenant      String   @default("admin") @db.VarChar(20)
  key         String   @unique @db.VarChar(150)
  value       String?  @db.Text
  group       String   @default("general")  @db.VarChar(60)
  description String?  @db.VarChar(500)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenant], map: "idx_tenant_config")
  @@index([group])
  @@map("system_configs")
}

/// Generic key-value system settings (single-level, flat)
model SystemSetting {
  id          Int      @id @default(autoincrement())
  tenant      String   @default("admin") @db.VarChar(20)
  key         String   @unique @db.VarChar(150)
  value       String?  @db.Text
  group       String   @default("general")  @db.VarChar(60)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenant], map: "idx_tenant_config")
  @@index([group])
  @@map("system_settings")
}

/// Per-project UI / feature config (grouped by module + group + key)
model ProjectConfig {
  id          String   @id @default(cuid())
  tenant      String   @default("admin") @db.VarChar(20)
  projectCode String   @db.VarChar(20)
  module      String   @db.VarChar(60)
  group       String   @db.VarChar(60)
  key         String   @db.VarChar(150)
  value       Json?
  type        String   @default("string")   @db.VarChar(20)   // string|number|boolean|json|image|password
  options     Json?
  validation  Json?
  description String?  @db.VarChar(500)
  isSecret    Boolean  @default(false)
  editable    Boolean  @default(true)
  status      String   @default("active")   @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectCode, module, group, key])
  @@index([projectCode], map: "idx_proj_code")
  @@index([tenant], map: "idx_tenant_config")
  @@index([module])
  @@index([projectCode, group, status])
  @@map("project_configs")
}

model SystemLog {
  id        Int        @id @default(autoincrement())
  tenant    String     @default("admin") @db.VarChar(20)
  adminId   Int?
  admin     AdminUser? @relation(fields: [adminId], references: [id])
  action    String     @db.VarChar(100)
  module    String?    @db.VarChar(30)
  details   Json?
  ip        String?    @db.VarChar(45)
  userAgent String?    @db.VarChar(500)
  status    String     @default("success") @db.VarChar(20)
  createdAt DateTime   @default(now())

  @@index([adminId, createdAt])
  @@index([tenant], map: "idx_tenant_config")
  @@index([action])
  @@map("system_logs")
}

model Backup {
  id          Int       @id @default(autoincrement())
  filename    String    @db.VarChar(255)
  size        Int?
  type        String    @db.VarChar(20)   // full|incremental
  status      String    @default("processing") @db.VarChar(20)
  note        String?   @db.Text
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status])
  @@map("backups")
}

// ═══════════════════════════════════════════════════════════════════════════
// WALLET & FINANCE
// ═══════════════════════════════════════════════════════════════════════════

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  currency  String   @default("VND") @db.VarChar(10)
  balance   Decimal  @default(0)  @db.Decimal(19,4)
  frozen    Decimal  @default(0)  @db.Decimal(19,4)
  version   Int      @default(0)                      // Optimistic lock — increment on every balance write
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@unique([userId, currency])
  @@index([userId])
  @@map("wallets")
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  walletId      String
  wallet        Wallet   @relation(fields: [walletId], references: [id])
  type          String   @db.VarChar(30)    // deposit|withdraw|transfer|bonus|commission|payment|refund|bet|win|fee|interest|rebate
  source        String   @default("HUB")   @db.VarChar(20)   // GAME|SPORTS|TRADE|DATING|HUB|ADMIN|SYSTEM
  amount        Decimal  @db.Decimal(19,4)
  fee           Decimal  @default(0) @db.Decimal(19,4)
  status        String   @default("pending") @db.VarChar(20)
  referenceId   String?  @unique @db.VarChar(60)              // Idempotency key — unique per external transaction
  referenceType String?  @db.VarChar(30)
  description   String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, type, createdAt])
  @@index([status, createdAt])
  @@index([source, type, createdAt])
  @@map("transactions")
}

// ═══════════════════════════════════════════════════════════════════════════
// GROUP FINANCE — FEE CONFIG, PROJECT BALANCE, INTERNAL LOAN
// Implements "Pool Capital, Split Profit" (Gộp Vốn, Tách Lợi Nhuận)
// ═══════════════════════════════════════════════════════════════════════════

/// Dynamic fee configuration per project-source and transaction type.
/// Admin can adjust fees live without code deploys.
model FeeConfig {
  id          String    @id @default(cuid())
  source      String    @db.VarChar(20)    // GAME|SPORTS|TRADE|DATING|HUB
  txType      String    @db.VarChar(20)    // BET|WIN|WITHDRAW|DEPOSIT
  feeType     String    @db.VarChar(20)    // PERCENTAGE|FIXED
  value       Decimal   @db.Decimal(8,4)   // e.g. 2.5000 for 2.5% or 50000 for fixed VND
  minAmount   Decimal?  @db.Decimal(19,4)  // minimum transaction amount to apply fee
  maxAmount   Decimal?  @db.Decimal(19,4)  // maximum transaction amount to apply fee
  maxFee      Decimal?  @db.Decimal(19,4)  // cap on the fee itself
  isActive    Boolean   @default(true)
  startDate   DateTime?
  endDate     DateTime?
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([source, txType])
  @@index([source, isActive])
  @@map("fee_configs")
}

/// Running balance book for each sub-project (can go negative = borrowed from Group Pool).
model ProjectBalance {
  id          String   @id @default(cuid())
  source      String   @unique @db.VarChar(20)  // GAME|SPORTS|TRADE|DATING|HUB
  balance     Decimal  @default(0) @db.Decimal(19,4)  // net position (negative = in debt to group)
  totalBet    Decimal  @default(0) @db.Decimal(19,4)
  totalWin    Decimal  @default(0) @db.Decimal(19,4)
  totalFee    Decimal  @default(0) @db.Decimal(19,4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("project_balances")
}

/// Records each internal loan event when a sub-project balance goes negative.
model InternalLoan {
  id           String    @id @default(cuid())
  source       String    @db.VarChar(20)    // borrowing project
  amount       Decimal   @db.Decimal(19,4)  // principal borrowed
  interestRate Decimal   @db.Decimal(7,4)   // daily rate e.g. 0.0005 = 0.05%/day
  startDate    DateTime  @default(now())
  endDate      DateTime?
  status       String    @default("ACTIVE") @db.VarChar(20)  // ACTIVE|PAID
  totalInterest Decimal  @default(0) @db.Decimal(19,4)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([source, status])
  @@map("internal_loans")
}

/// Fee log — one row per fee collected so reconciliation is easy.
model FeeLog {
  id          String   @id @default(cuid())
  userId      String   @db.VarChar(30)
  source      String   @db.VarChar(20)    // GAME|SPORTS|TRADE|DATING|HUB
  txType      String   @db.VarChar(20)    // BET|WIN|WITHDRAW
  grossAmount Decimal  @db.Decimal(19,4)
  feeAmount   Decimal  @db.Decimal(19,4)
  netAmount   Decimal  @db.Decimal(19,4)
  referenceId String?  @db.VarChar(60)
  createdAt   DateTime @default(now())

  @@index([source, createdAt])
  @@index([userId, createdAt])
  @@map("fee_logs")
}

model PaymentGateway {
  id         String   @id @default(cuid())
  code       String   @unique @db.VarChar(30)   // lkvip|usdt|momo|zalopay|vnpay|okpay
  name       String   @db.VarChar(100)
  type       String   @db.VarChar(20)            // bank|crypto|ewallet|card
  status     String   @default("active") @db.VarChar(20)
  config     Json?
  fees       Json?    // { percentage, fixed, min, max }
  limits     Json?    // { min, max, daily }
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  depositOrders  DepositOrder[]
  withdrawOrders WithdrawOrder[]

  @@index([status])
  @@map("payment_gateways")
}

model DepositOrder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  gatewayId   String
  gateway     PaymentGateway @relation(fields: [gatewayId], references: [id])
  amount      Decimal   @db.Decimal(19,4)
  currency    String    @default("VND") @db.VarChar(10)
  status      String    @default("pending") @db.VarChar(20)
  txId        String?   @db.VarChar(255)
  proof       String?   @db.VarChar(500)
  note        String?   @db.Text
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([gatewayId])
  @@index([status, createdAt])
  @@map("deposit_orders")
}

model WithdrawOrder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  gatewayId   String
  gateway     PaymentGateway @relation(fields: [gatewayId], references: [id])
  amount      Decimal   @db.Decimal(19,4)
  currency    String    @default("VND") @db.VarChar(10)
  address     String?   @db.VarChar(500)
  bankInfo    Json?
  status      String    @default("pending") @db.VarChar(20)
  txId        String?   @db.VarChar(255)
  note        String?   @db.Text
  rejectionReason String? @db.Text
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([gatewayId])
  @@index([status, createdAt])
  @@map("withdraw_orders")
}

model InternalTransfer {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  fromWallet String
  toWallet   String
  amount     Decimal  @db.Decimal(19,4)
  fee        Decimal  @default(0) @db.Decimal(19,4)
  status     String   @default("pending") @db.VarChar(20)
  note       String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@map("internal_transfers")
}

// ═══════════════════════════════════════════════════════════════════════════
// KYC & COMPLIANCE
// ═══════════════════════════════════════════════════════════════════════════

model KycDocument {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   @db.VarChar(30)    // passport|id_card|selfie|address_proof
  frontImage  String   @db.VarChar(500)
  backImage   String?  @db.VarChar(500)
  selfieImage String?  @db.VarChar(500)
  status      String   @default("pending") @db.VarChar(20)
  reason      String?  @db.Text
  reviewedBy  String?  @db.VarChar(60)
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("kyc_documents")
}

model RiskScore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  score     Int      @default(0)
  level     String   @default("low") @db.VarChar(20)
  reason    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("risk_scores")
}

model RiskRule {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(150)
  description String?  @db.Text
  conditions  Json?
  action      String   @db.VarChar(30)   // hold|block|notify|freeze
  priority    Int      @default(1)
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  riskAlerts  RiskAlert[]

  @@map("risk_rules")
}

model RiskAlert {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  ruleId     String
  rule       RiskRule @relation(fields: [ruleId], references: [id])
  details    Json?
  status     String   @default("new") @db.VarChar(20)
  resolvedBy String?  @db.VarChar(60)
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("risk_alerts")
}

model IpBlacklist {
  id        String   @id @default(cuid())
  ip        String   @unique @db.VarChar(45)
  reason    String?  @db.Text
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([ip])
  @@map("ip_blacklist")
}

model UserDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  deviceId    String   @db.VarChar(255)
  deviceType  String?  @db.VarChar(20)
  userAgent   String?  @db.VarChar(500)
  ip          String?  @db.VarChar(45)
  trusted     Boolean  @default(false)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("user_devices")
}

model AmlAlert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   @db.VarChar(50)    // structuring|rapid_turnover|cross_project|large_deposit
  severity    String   @default("medium") @db.VarChar(20)
  details     Json?
  status      String   @default("open")   @db.VarChar(20)
  resolvedBy  String?  @db.VarChar(60)
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("aml_alerts")
}

model SecurityLog {
  id        String   @id @default(cuid())
  tenant    String   @default("admin") @db.VarChar(20)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  event     String   @db.VarChar(60)    // login_failed|2fa_failed|ip_blocked|password_changed
  severity  String?  @default("medium") @db.VarChar(20)   // low|medium|high|critical
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  details   Json?
  createdAt DateTime @default(now())

  @@index([tenant], map: "idx_tenant_config")
  @@index([userId])
  @@index([event, createdAt])
  @@index([severity, createdAt])
  @@map("security_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// REFERRAL & COMMISSION
// ═══════════════════════════════════════════════════════════════════════════

model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  referrer      User     @relation("Referrer", fields: [referrerId], references: [id])
  refereeId     String   @unique
  referee       User     @relation("Referee",  fields: [refereeId],  references: [id])
  sourceProject String?  @db.VarChar(20)
  status        String   @default("active") @db.VarChar(20)
  commission    Decimal  @default(0) @db.Decimal(19,4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([referrerId])
  @@map("referrals")
}

model Commission {
  id            String   @id @default(cuid())
  referrerId    String
  referrer      User     @relation(fields: [referrerId], references: [id])
  refereeId     String
  amount        Decimal  @db.Decimal(19,4)
