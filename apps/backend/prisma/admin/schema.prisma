  @@map("ops_knowledge_base")
}

model Announcement {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(255)
  content    String   @db.Text
  type       String   @default("info")    @db.VarChar(20)   // info|warning|maintenance|promotion
  projects   Json?    // null = all projects
  startAt    DateTime
  endAt      DateTime
  status     String   @default("active")  @db.VarChar(20)
  createdAt  DateTime @default(now())
