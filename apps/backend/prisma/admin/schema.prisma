// ═══════════════════════════════════════════════════════════════════════════
// AUTO-OPS PLATFORM
// ═══════════════════════════════════════════════════════════════════════════

/// RFM segmentation + CLV store — one row per (project, userId) pair
model OpsUserSegment {
  id          Int      @id @default(autoincrement())
  project     String   @default("game") @db.VarChar(20)   // hub|game|trade|dating|sports
  userId      String   @db.VarChar(30)                    // external user ID (CUID from project DBs)
  segment     String   @default("bronze") @db.VarChar(20)   // champion|gold|silver|at_risk|bronze
  rScore      Int      @default(1)
  fScore      Int      @default(1)
  mScore      Int      @default(1)
  recencyDays Float    @default(999)
  frequency   Int      @default(0)
  monetary    Decimal  @default(0) @db.Decimal(19,4)
  clv         Decimal  @default(0) @db.Decimal(19,4)
  avgMonthly  Decimal  @default(0) @db.Decimal(19,4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([project, userId])
  @@index([project, segment])
  @@index([clv])
  @@map("ops_user_segments")
}

/// Churn risk alerts — populated by ChurnPredictor.scanAll()
model OpsChurnAlert {
  id           Int      @id @default(autoincrement())
  project      String   @default("game") @db.VarChar(20)   // hub|game|trade|dating|sports
  userId       String   @db.VarChar(30)                    // external user ID (CUID from project DBs)
  riskLevel    String   @db.VarChar(10)   // high | medium
  reason       String   @db.VarChar(60)
  score        Float    @default(0)
  daysInactive Int      @default(0)
  handled      Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([project, userId])
  @@index([project, riskLevel, createdAt])
  @@map("ops_churn_alerts")
}

/// Operational task queue with auto-assignment
model OpsTask {
  id          Int       @id @default(autoincrement())
  type        String    @db.VarChar(40)    // withdraw|deposit|kyc|support|bug|campaign|churn|expense_approval
  title       String    @db.VarChar(255)
  description String?   @db.Text
  userId      Int?                         // related user (if any)
  assignedTo  Int?
  agent       AdminUser? @relation("AssignedTasks", fields: [assignedTo], references: [id])
  priority    String    @default("medium") @db.VarChar(20)   // critical|high|medium|low
  status      String    @default("pending") @db.VarChar(20)  // pending|in_progress|completed|cancelled
  metadata    Json?
  completedAt DateTime?
  completedBy Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([assignedTo, status])
  @@index([status, priority])
  @@index([type])
  @@map("ops_tasks")
}

/// Marketing / campaign fire log — deduplication + analytics
model OpsCampaignLog {
  id           Int      @id @default(autoincrement())
  project      String   @default("game") @db.VarChar(20)   // hub|game|trade|dating|sports
  userId       Int
  campaignName String   @db.VarChar(100)
  segment      String?  @db.VarChar(20)
  action       String   @db.VarChar(40)
  status       String   @default("sent") @db.VarChar(20)
  createdAt    DateTime @default(now())

  @@index([project, userId, campaignName])
  @@index([project, createdAt])
  @@map("ops_campaign_logs")
}

/// Daily operational reports
model OpsDailyReport {
  id        Int      @id @default(autoincrement())
  date      String   @unique @db.VarChar(10)   // YYYY-MM-DD
  payload   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([date])
  @@map("ops_daily_reports")
}

/// Auto-ops platform alerts (cash reserve, anomalies, etc.)
model OpsAlert {
  id        Int      @id @default(autoincrement())
  type      String   @db.VarChar(60)
  message   String   @db.Text
  severity  String   @default("medium") @db.VarChar(20)   // low|medium|high|critical
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type, resolved])
  @@map("ops_alerts")
}

/// Expense approval requests
model OpsExpenseRequest {
  id             Int       @id @default(autoincrement())
  title          String    @db.VarChar(255)
  amount         Decimal   @db.Decimal(19,4)
  category       String    @db.VarChar(60)
  note           String?   @db.Text
  status         String    @default("pending") @db.VarChar(20)   // pending|approved|rejected
  requestedBy    Int?
  approvedBy     Int?
  approvedAt     DateTime?
  approvalMethod String?   @db.VarChar(20)   // auto|manual
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@map("ops_expense_requests")
}

/// Knowledge base for ticket auto-reply
model OpsKnowledgeBase {
  id          Int      @id @default(autoincrement())
  category    String   @db.VarChar(50)
  title       String   @db.VarChar(255)
  content     String   @db.Text
