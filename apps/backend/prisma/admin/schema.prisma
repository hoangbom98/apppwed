// ═══════════════════════════════════════════════════════════════════════════
// APP CATALOG  — mobile app metadata & download links
// ═══════════════════════════════════════════════════════════════════════════

/// One entry per downloadable sub-project app (game, dating, sports, trade)
model AppCatalog {
  id           Int      @id @default(autoincrement())
  appId        String   @unique @db.VarChar(50)   // slug: 'game' | 'dating' | 'sports' | 'trade'
  name         String   @db.VarChar(255)
  developer    String?  @db.VarChar(255)
  category     String?  @db.VarChar(60)           // e.g. 'Giải trí · 18+'
  iconUrl      String?  @db.VarChar(500)
  primaryColor String?  @db.VarChar(20)            // hex color for branding
  rating       Decimal  @default(5.0) @db.Decimal(3,1)
  reviewsCount String?  @db.VarChar(30)            // e.g. '12.5 N'
  downloads    String?  @db.VarChar(30)            // e.g. '500 N+'
  androidLink  String?  @db.VarChar(1000)
  iosLink      String?  @db.VarChar(1000)
  description  String?  @db.Text
  features     Json?                                // string[]
  isPublished  Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished])
  @@map("app_catalog")
}

// ═══════════════════════════════════════════════════════════════════════════
// COLD STORAGE — ARCHIVE LOG
// Records every monthly archive operation (Tầng 2: Cold Storage)
// ═══════════════════════════════════════════════════════════════════════════

/// Tracks every cold-storage archive run so admin can audit or restore data
model ArchiveLog {
  id           Int      @id @default(autoincrement())
  tableName    String   @db.VarChar(60)   // e.g. "transactions"
  project      String   @db.VarChar(20)   // game|hub|trade|dating|sports|admin
  archiveKey   String   @db.VarChar(500)  // S3/R2 object key
  recordCount  Int      @default(0)
  sizeBytes    BigInt?                    // compressed file size in bytes
  cutoffDate   DateTime                   // data older than this was archived
  status       String   @default("completed") @db.VarChar(20)
  error        String?  @db.Text
  archivedAt   DateTime @default(now())

  @@index([project])
  @@index([tableName, archivedAt])
  @@map("archive_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// THIRD-PARTY PROVIDER CALL LOG
// Audit trail for every outbound call to a game/payment/price-feed provider.
// Stored in admin_db so ALL projects share one central log.
// ═══════════════════════════════════════════════════════════════════════════

/// One row per outbound call to any third-party provider.
/// Populated by the ThirdParty service layer — not by individual modules.
model ThirdPartyCallLog {
  id            Int      @id @default(autoincrement())
  providerCode  String   @db.VarChar(30)    // 'GSC' | 'GOLDGATE' | 'TCGAMING' | 'BINANCE' | …
  serviceType   String   @db.VarChar(30)    // ServiceType enum value: 'GAME_API' | 'PRICE_FEED' | …
  project       String?  @db.VarChar(20)    // calling project: 'game' | 'sports' | 'trade' | …
  userId        String?  @db.VarChar(30)    // project-local user ID (if applicable)
  action        String?  @db.VarChar(60)    // 'launch' | 'balance' | 'transaction' | 'price' | …
  requestSummary Json?                      // sanitised subset of request payload (no secrets)
  responseStatus Int?                       // HTTP status code from provider
  durationMs    Int?                        // round-trip time in milliseconds
  success       Boolean  @default(true)
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([providerCode, createdAt])
  @@index([project, createdAt])
  @@index([success, createdAt])
  @@map("third_party_call_logs")
}

/// Provider health snapshots (polled every minute by HealthCheckManager).
model ThirdPartyHealthSnapshot {
  id           Int      @id @default(autoincrement())
  providerCode String   @db.VarChar(30)
  healthy      Boolean
  latencyMs    Int?
  checkedAt    DateTime @default(now())

  @@index([providerCode, checkedAt])
  @@map("third_party_health_snapshots")
}

// ═══════════════════════════════════════════════════════════════════════════
// TELEGRAM BROADCAST & AUTO-REPLY  (v2.3)
// ═══════════════════════════════════════════════════════════════════════════

/// Admin-composed Telegram broadcasts — one row per outgoing message batch.
/// Targets: channel (public), group (community), admin (internal).
model TelegramBroadcast {
  id          Int      @id @default(autoincrement())
  /// Target chat identifier stored in DB (e.g. @lkvip_channel or -100xxx)
  target      String   @db.VarChar(100)   // channel | group | admin | custom
  targetName  String   @default("channel") @db.VarChar(30)
  /// Telegram parse mode: HTML | Markdown
  parseMode   String   @default("HTML") @db.VarChar(10)
  content     String   @db.Text
  templateKey String?  @db.VarChar(60)    // optional ref to NotificationTemplate.type
  variables   Json?                        // { key: value } substitutions used
  /// pending | sent | failed
  status      String   @default("pending") @db.VarChar(20)
  sentBy      Int?                         // AdminUser.id
  sentAt      DateTime?
  error       String?  @db.Text
  messageId   Int?                         // Telegram message_id returned on success
  /// For scheduled sends — null = send immediately
  scheduledAt DateTime?
  createdAt   DateTime @default(now())

  @@index([target, status])
  @@index([createdAt])
  @@map("telegram_broadcasts")
}

/// Auto-reply rules for the CSKH Telegram bot.
/// When an incoming message matches the keyword (plain text or regex),
/// the bot replies with the configured content.
model TelegramAutoReply {
  id          Int      @id @default(autoincrement())
  /// Plain text phrase or regex pattern (if isRegex = true)
  keyword     String   @db.VarChar(255)
  isRegex     Boolean  @default(false)
  ignoreCase  Boolean  @default(true)
  /// Bot reply text — supports Telegram HTML
  reply       String   @db.Text
  /// Category for grouping in UI: greeting | finance | support | promo | fallback
  category    String   @default("support") @db.VarChar(30)
  isActive    Boolean  @default(true)
  /// Higher priority = matched first
  priority    Int      @default(0)
  /// Number of times this rule has fired (stats)
  hitCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, priority])
  @@map("telegram_auto_replies")
}

// ═══════════════════════════════════════════════════════════════════════════
// NOTIFICATION TEMPLATES & CRON JOBS  (v2.2)
// ═══════════════════════════════════════════════════════════════════════════

/// Reusable notification templates — support Telegram + Email channels.
/// Content uses {variable} syntax, resolved at send time.
model NotificationTemplate {
  id          Int      @id @default(autoincrement())
  /// Unique machine key: 'order_admin' | 'order_user' | 'deposit_admin' | …
  type        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(150)
  subject     String?  @db.VarChar(255)      // email subject (optional)
  content     String   @db.Text              // body — HTML or Telegram markdown
  channel     String   @default("both") @db.VarChar(10)  // email|telegram|both
  /// JSON array of variable names used in this template, e.g. ["{domain}","{username}"]
  variables   Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logs NotificationLog[]

  @@index([channel, isActive])
  @@map("notification_templates")
}

/// Outbound notification delivery log — one row per send attempt.
model NotificationLog {
  id          Int                   @id @default(autoincrement())
  templateId  Int?
  template    NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  channel     String                @db.VarChar(10)   // email|telegram
  recipient   String                @db.VarChar(255)  // email address or Telegram chat_id
  subject     String?               @db.VarChar(255)
  content     String                @db.Text
  /// pending|sent|failed
  status      String                @default("pending") @db.VarChar(20)
  error       String?               @db.Text
  sentAt      DateTime?
  createdAt   DateTime              @default(now())

  @@index([templateId, createdAt])
  @@index([status, createdAt])
  @@map("notification_logs")
}

/// Scheduled background jobs — displayed in the admin Cron Jobs panel.
model CronJob {
  id          Int       @id @default(autoincrement())
  /// Human-readable unique name: 'Cron Job Chính' | 'Cron Job Bank' | …
  name        String    @unique @db.VarChar(150)
  description String?   @db.Text
  /// URL path or command executed by the scheduler
  command     String    @db.VarChar(500)
  /// Cron expression: '*/5 * * * *'
  schedule    String    @db.VarChar(60)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  /// active|inactive|failed|running
  status      String    @default("active") @db.VarChar(20)
  log         String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@map("cron_jobs")
}

// ═══════════════════════════════════════════════════════════════════════════
// RBAC — ROLES & PERMISSIONS  (học từ Boyue role.html)
// ═══════════════════════════════════════════════════════════════════════════

/// Admin role (RBAC). Each AdminUser can be assigned one roleId.
/// permissions = string[] stored as JSON — e.g. ["users.view","finance.approve"]
model AdminRole {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(60)   // 'super_admin'|'admin'|'finance'|'support'…
  displayName String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  permissions Json?                                // string[] permission keys
  sortOrder   Int       @default(0)
  status      String    @default("active") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  adminUsers  AdminUser[] @relation("AdminUserRole")

  @@index([status])
  @@map("admin_roles")
}

// ═══════════════════════════════════════════════════════════════════════════
// REBATE SYSTEM
// Admin configures rebate rules (RebateRule); per-user claims are tracked in
// RebateClaim. Fine-grained per-game-type + VIP rates live in game_db (Rebate).
// BoYue equivalent: caipiao_rebate_category_config / caipiao_fanshui
// ═══════════════════════════════════════════════════════════════════════════

/// Rebate rule — admin-configured rate per game type and settlement period.
/// Example: { name: "Slot Daily 0.5%", gameType: "slot", rebateRate: 0.0050, period: "daily" }
model RebateRule {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  /// Game type key: live | slot | lottery | sports | null (all types)
  gameType    String?  @db.VarChar(30)
  /// Rebate rate as decimal fraction: 0.0050 = 0.5%
  rebateRate  Decimal  @db.Decimal(6,4)
  /// Minimum valid bet required to qualify for rebate
  minBet      Decimal  @default(0) @db.Decimal(18,2)
  /// Settlement period: daily | weekly | monthly
  period      String   @default("daily") @db.VarChar(20)
  project     String   @default("game") @db.VarChar(20)
  sortOrder   Int      @default(0)
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  claims      RebateClaim[]

  @@index([project, status])
  @@map("rebate_rules")
}

/// Per-user rebate claim — one record per (rule, user, period).
/// Status lifecycle: pending → approved → paid  OR  rejected
model RebateClaim {
  id           Int       @id @default(autoincrement())
  ruleId       Int
  rule         RebateRule @relation(fields: [ruleId], references: [id])
  /// User ID in the project DB (game_db or trade_db)
  userId       String    @db.VarChar(30)
  project      String    @default("game") @db.VarChar(20)
  /// Period key: "2025-07" (monthly) or "2025-07-10" (daily)
  period       String    @db.VarChar(30)
  totalBet     Decimal   @default(0) @db.Decimal(18,2)
  rebateAmount Decimal   @default(0) @db.Decimal(18,2)
  /// pending | approved | rejected
  status       String    @default("pending") @db.VarChar(20)
  approvedBy   String?   @db.VarChar(30)
  approvedAt   DateTime?
  note         String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([ruleId, userId, period])
  @@index([userId, status])
  @@index([project, period])
  @@map("rebate_claims")
}


/// Per-project SMS delivery log
/// Records every send attempt for audit, debugging, and rate-limit tracking.
model SmsLog {
  id        Int      @id @default(autoincrement())
  /// Project that triggered the send: 'game' | 'hub' | 'trade' | 'dating' | 'sports' | 'global'
  project   String   @db.VarChar(20)
  phone     String   @db.VarChar(20)
  body      String   @db.Text
  /// 'twilio' | 'console'
  provider  String   @db.VarChar(30)
  /// 'sent' | 'failed'
  status    String   @default("sent") @db.VarChar(10)
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([project, createdAt])
  @@index([phone, createdAt])
  @@index([status, createdAt])
  @@map("sms_logs")
}
