// =============================================================================
// LKVIP PAYMENT GATEWAY — Internal payment layer
// VirtualAccount & WithdrawalRequest are managed by src/modules/lkvip/
// LkvipTransaction is the financial ledger for the lkvip subsystem
// =============================================================================

/// LKvip internal transaction ledger (supplement to general Transaction model)
/// Used by lkvip module for its own deposit/withdraw/adjustment flow
model LkvipTransaction {
  id            String   @id @default(cuid())
  userId        String   @db.VarChar(30)
  user          User     @relation(fields: [userId], references: [id])
  // deposit | withdraw | refund | adjustment | bonus | commission
  type          String   @db.VarChar(30)
  amount        Decimal  @db.Decimal(19, 4)
  balanceBefore Decimal  @default(0) @db.Decimal(19, 4)
  balanceAfter  Decimal  @default(0) @db.Decimal(19, 4)
  referenceType String?  @db.VarChar(30) // va | withdrawal | deposit_order
  referenceId   String?  @db.VarChar(60)
  description   String?  @db.VarChar(500)
  // pending | completed | failed
  status        String   @default("completed") @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, type])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("lkvip_transactions")
}

/// WithdrawalRequest — LKvip withdrawal lifecycle table (distinct from WithdrawOrder)
/// Created by TransferService, approved/rejected by admin via lkvip admin routes
model WithdrawalRequest {
  id                String    @id @default(cuid())
  userId            String    @db.VarChar(30)
  user              User      @relation(fields: [userId], references: [id])
  amount            Decimal   @db.Decimal(19, 4)
  bankAccountNumber String    @db.VarChar(30)
  bankName          String    @db.VarChar(100)
  bankBin           String?   @db.VarChar(20)
  accountHolder     String    @db.VarChar(100)
  // pending | processing | completed | rejected | cancelled
  status            String    @default("pending") @db.VarChar(20)
  rejectionReason   String?   @db.VarChar(500)
  transferId        String?   @db.VarChar(100) // external payment reference
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

// =============================================================================
// REBATE / CASHBACK
//
// Rebate is calculated T+1 (next day) based on validBet per game type.
// Rates are configured per VIP level — see DEFAULT_VIP_REBATE_RATES in @lkvip/types.
// Admin can override rates via RebateRule records in admin_db.
// Settlement cron: 23:55 UTC calculate → 01:00 UTC settle (pending → claimable → claimed).
//
// gameType values (align with GameTypeKey enum in @lkvip/constants):
//   'live'    → live casino (Evolution, Goldgate Live)
//   'slot'    → RNG / slot / fishing (CQ9, PG Soft, JILI, JDB)
//   'lottery' → lottery products (PC28, KENO, TCG LOTTO)
//   'sports'  → sports / esports (BTI, SBO, UG2, CMD368)
// =============================================================================

model BetStats {
  id         String   @id @default(cuid())
  userId     String   @db.VarChar(30)
  user       User     @relation(fields: [userId], references: [id])
  // Date string "2025-01-15" — one row per user per date per gameType
  date       String   @db.VarChar(10)
  // live | slot | lottery | sports
  gameType   String   @db.VarChar(20)
  // aggregator: GSC | GOLDGATE | TCGAMING
  aggregator String   @default("") @db.VarChar(30)
  validBet   Decimal  @default(0) @db.Decimal(19, 4) // valid wager (unsettled excluded)
  totalBet   Decimal  @default(0) @db.Decimal(19, 4) // gross bet placed
  totalWin   Decimal  @default(0) @db.Decimal(19, 4) // gross win received
  roundCount Int      @default(0) // number of rounds
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, date, gameType, aggregator])
  @@index([userId, date])
  @@index([date, gameType])
  @@map("bet_stats")
}

model Rebate {
  id        String    @id @default(cuid())
  userId    String    @db.VarChar(30)
  user      User      @relation(fields: [userId], references: [id])
  // "2025-01-15" — the betting date this rebate is for (T)
  betDate   String    @db.VarChar(10)
  // live | slot | lottery | sports
  gameType  String    @db.VarChar(20)
  validBet  Decimal   @db.Decimal(19, 4) // total valid bet on betDate
  rate      Decimal   @db.Decimal(6, 4) // rebate rate applied (e.g. 0.0050 = 0.5%)
  amount    Decimal   @db.Decimal(19, 4) // rebate amount = validBet × rate
  vipLevel  Int       @default(1)
  // pending (T+0 night) | claimable (after T+1 cron) | claimed | expired
  status    String    @default("pending") @db.VarChar(20)
  claimedAt DateTime?
  settledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, betDate, gameType])
  @@index([userId, status])
  @@index([betDate, status])
  @@index([status, createdAt])
  @@map("rebates")
}

// =============================================================================
// SAVINGS VAULT — Money Market
// Named "Savings Vault" in code/API; displayed as "Tiết kiệm" in VI, "Savings" in EN.
// BoYue equivalent: caipiao_yeb_config / caipiao_yeb_record / yzz_yuebao_holding.
// Daily interest is calculated via BullMQ game-savingsVault-interest queue at 00:05 UTC.
// =============================================================================

model SavingsVaultProduct {
  id           String   @id @default(cuid())
  title        String   @db.VarChar(100) // "Flexible" | "7 Days" | "30 Days" | "VIP 90 Days"
  days         Int // lock period in days (0 = flexible)
  interestRate Decimal  @db.Decimal(6, 4) // daily rate, e.g. 0.0012 = 0.12%/day
  minAmount    Decimal  @db.Decimal(19, 4) // minimum investment
  maxAmount    Decimal? @db.Decimal(19, 4) // null = unlimited
  stars        Int      @default(0) // display stars (0–5)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  holdings SavingsVaultHolding[]

  @@map("savings_vault_products")
}

model SavingsVaultHolding {
  id         String              @id @default(cuid())
  userId     String              @db.VarChar(30)
  productId  String              @db.VarChar(30)
  product    SavingsVaultProduct @relation(fields: [productId], references: [id])
  amount     Decimal             @db.Decimal(19, 4) // principal invested
  profitPaid Decimal             @default(0) @db.Decimal(19, 4) // total interest paid out
  startDate  DateTime            @default(now())
  endDate    DateTime? // null for flexible
  // active | completed | cancelled
  status     String              @default("active") @db.VarChar(20)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([userId, status])
  @@index([status, endDate])
  @@map("savings_vault_holdings")
}

// =============================================================================
// MINING MACHINE — Machine investments yielding daily income
// BoYue equivalent: investment machine concept (daily fixed income model).
// Income distributed via BullMQ mining-distribution worker at 01:00 UTC daily.
//
// MiningMachine  — admin-configured products (price, daily income, duration)
// MiningHolding  — user's active purchased machines
// =============================================================================

model MiningMachine {
  id           String   @id @default(cuid())
  title        String   @db.VarChar(100)
  description  String?  @db.VarChar(500)
  image        String?  @db.VarChar(500)
  price        Decimal  @db.Decimal(19, 4) // cost to buy (stake)
  dayIncome    Decimal  @db.Decimal(19, 4) // income per day per machine
  duration     Int      @default(0) // 0 = unlimited, N = N days
  totalStock   Int      @default(0) // 0 = unlimited
  stock        Int      @default(0) // remaining stock
  perUserLimit Int      @default(0) // 0 = unlimited
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  holdings MiningHolding[]

  @@map("mining_machines")
}

model MiningHolding {
  id         String        @id @default(cuid())
  userId     String        @db.VarChar(30)
  machineId  String        @db.VarChar(30)
  machine    MiningMachine @relation(fields: [machineId], references: [id])
  quantity   Int           @default(1)
  deposit    Decimal       @db.Decimal(19, 4) // total stake (price × quantity)
  dayIncome  Decimal       @db.Decimal(19, 4) // daily income (machine.dayIncome × quantity)
  profitPaid Decimal       @default(0) @db.Decimal(19, 4)
  startDate  DateTime      @default(now())
  endDate    DateTime? // null = unlimited duration
  // active | completed | cancelled
  status     String        @default("active") @db.VarChar(20)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId, status])
  @@index([status, endDate])
  @@map("mining_holdings")
}

// =============================================================================
// GIFT CODE — Promotional redemption codes (Mã quà tặng)
// BoYue equivalent: caipiao_giftcode / caipiao_cdkey
//
// Admin creates GiftCode records; users redeem them via POST /game/giftcode/redeem.
// On redemption: balance credited + GiftCodeRedemption record created.
// Duplicate prevention: unique(giftCodeId, userId).
// =============================================================================

model GiftCode {
  id            String   @id @default(cuid())
  /// Unique alphanumeric code entered by user, e.g. "LKVIP2025"
  code          String   @unique @db.VarChar(50)
  /// Reward type: balance | bonus | free_spin | vip_exp
  rewardType    String   @db.VarChar(20)
  rewardAmount  Decimal  @db.Decimal(19, 4)
  /// Total redemption cap (null = unlimited)
  maxUses       Int?
  /// Per-user redemption limit (default 1)
  maxPerUser    Int      @default(1)
  usedCount     Int      @default(0)
  /// Minimum VIP level required (0 = any)
  minVipLevel   Int      @default(0)
  startDate     DateTime?
  endDate       DateTime?
  /// active | inactive | depleted | expired
  status        String   @default("active") @db.VarChar(20)
  note          String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  redemptions   GiftCodeRedemption[]

  @@index([code])
  @@index([status, startDate, endDate])
  @@map("gift_codes")
}

/// One row per user per gift code — prevents duplicate redemption.
model GiftCodeRedemption {
  id           String    @id @default(cuid())
  giftCodeId   String    @db.VarChar(30)
  giftCode     GiftCode  @relation(fields: [giftCodeId], references: [id])
  userId       String    @db.VarChar(30)
  rewardAmount Decimal   @db.Decimal(19, 4)
  redeemedAt   DateTime  @default(now())

  @@unique([giftCodeId, userId])
  @@index([userId])
  @@index([giftCodeId])
  @@map("gift_code_redemptions")
}
