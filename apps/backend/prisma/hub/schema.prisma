// ═══════════════════════════════════════════════════════════════════════════
// prisma/hub/schema.prisma  —  Hub Portal Database  v2.1
// Database: hub_db  |  Charset: utf8mb4_unicode_ci
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/hub-client"
}

datasource db {
  provider = "mysql"
  url      = env("HUB_DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// USERS
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(191)
  phone        String?   @unique @db.VarChar(20)
  username     String?   @unique @db.VarChar(50)
  password     String    @db.VarChar(255)
  fullName     String?   @db.VarChar(150)
  avatar       String?   @db.VarChar(500)
  bio          String?   @db.Text
  role         String    @default("user")   @db.VarChar(20)
  // active | suspended | banned | deleted
  status       String    @default("active") @db.VarChar(20)
  referralCode String?   @unique @db.VarChar(30)
  referredBy   String?   @db.VarChar(30)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notifications Notification[]
  favorites     Favorite[]
  comments      Comment[]
  ratings       Rating[]
  feedbacks     Feedback[]

  @@index([email])
  @@index([username])
  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTENT TAXONOMY
// ═══════════════════════════════════════════════════════════════════════════

model Category {
  id        String     @id @default(cuid())
  name      String     @db.VarChar(150)
  slug      String     @unique @db.VarChar(150)
  type      String     @db.VarChar(20)    // game|website|tool|news
  icon      String?    @db.VarChar(500)
  cover     String?    @db.VarChar(500)
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  sortOrder Int        @default(0)
  status    String     @default("active") @db.VarChar(20)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  games    Game[]
  websites Website[]
  tools    Tool[]
  news     News[]

  @@index([type, status])
  @@index([slug])
  @@map("categories")
}

// ═══════════════════════════════════════════════════════════════════════════
// GAMES
// ═══════════════════════════════════════════════════════════════════════════

model Game {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  description String?  @db.Text
  publisher   String?  @db.VarChar(100)
  image       String?  @db.VarChar(500)
  cover       String?  @db.VarChar(500)
  link        String   @db.VarChar(500)
  platform    String?  @db.VarChar(20)   // web|android|ios|all
  isFeatured  Boolean  @default(false)
  isHot       Boolean  @default(false)
  viewCount   Int      @default(0)
  sortOrder   Int      @default(0)
  status      String   @default("active") @db.VarChar(20)
  tags        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites Favorite[]

  @@index([categoryId, status])
  @@index([isFeatured, status])
  @@index([slug])
  @@map("games")
}

// ═══════════════════════════════════════════════════════════════════════════
// WEBSITES
// ═══════════════════════════════════════════════════════════════════════════

model Website {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  description String?  @db.Text
  logo        String?  @db.VarChar(500)
  link        String   @db.VarChar(500)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId, status])
  @@index([slug])
  @@map("websites")
}

// ═══════════════════════════════════════════════════════════════════════════
// TOOLS / DOWNLOADS
// ═══════════════════════════════════════════════════════════════════════════

model Tool {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  description String?  @db.Text
  logo        String?  @db.VarChar(500)
  link        String   @db.VarChar(500)
  os          String?  @db.VarChar(20)   // android|ios|windows|macos|all
  version     String?  @db.VarChar(20)
  fileSize    String?  @db.VarChar(20)
  sortOrder   Int      @default(0)
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId, status])
  @@index([slug])
  @@map("tools")
}

model DownloadItem {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  platform    String   @db.VarChar(20)    // android|ios|windows|macos
  downloadUrl String   @db.VarChar(500)
  version     String?  @db.VarChar(20)
  fileSize    String?  @db.VarChar(20)
  changelog   String?  @db.Text
  downloads   Int      @default(0)
  sortOrder   Int      @default(0)
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([platform, status])
  @@map("download_items")
}

// ═══════════════════════════════════════════════════════════════════════════
// NEWS / BLOG
// ═══════════════════════════════════════════════════════════════════════════

model News {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  title       String   @db.VarChar(500)
  slug        String   @unique @db.VarChar(500)
  summary     String?  @db.Text
  content     String   @db.LongText
  image       String?  @db.VarChar(500)
  author      String?  @db.VarChar(100)
  views       Int      @default(0)
  isHot       Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  publishedAt DateTime?
  status      String   @default("draft") @db.VarChar(20)   // draft|published|archived
  tags        Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments  Comment[]
  ratings   Rating[]

  @@index([categoryId, status, publishedAt])
  @@index([isFeatured, status])
  @@index([slug])
  @@map("news")
}

// ═══════════════════════════════════════════════════════════════════════════
// CMS
// ═══════════════════════════════════════════════════════════════════════════

model Page {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  content     String   @db.LongText
  seoTitle    String?  @db.VarChar(255)
  seoDesc     String?  @db.Text
  seoKeywords String?  @db.VarChar(255)
  status      String   @default("draft") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug, status])
  @@map("pages")
}

model Banner {
  id            String   @id @default(cuid())
  title         String   @db.VarChar(255)
  imageDesktop  String   @db.VarChar(500)
  imageMobile   String?  @db.VarChar(500)
  link          String?  @db.VarChar(500)
  position      String   @db.VarChar(30)    // home|games|news|sidebar
  type          String   @default("slider") @db.VarChar(20)   // slider|popup|fixed
  openNewTab    Boolean  @default(false)
  sortOrder     Int      @default(0)
  startDate     DateTime?
  endDate       DateTime?
  status        String   @default("active") @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([position, status])
  @@map("banners")
}

model Menu {
  id        String   @id @default(cuid())
  label     String   @db.VarChar(100)
  url       String   @db.VarChar(500)
  icon      String?  @db.VarChar(100)
  parentId  String?
  parent    Menu?    @relation("MenuChildren", fields: [parentId], references: [id])
  children  Menu[]   @relation("MenuChildren")
  position  String   @default("header") @db.VarChar(20)
  openNewTab Boolean @default(false)
  sortOrder Int      @default(0)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position, status])
  @@map("menus")
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(150)
  value       String?  @db.Text
  group       String   @default("general") @db.VarChar(60)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@map("settings")
}

model SeoMeta {
  id          String   @id @default(cuid())
  path        String   @unique @db.VarChar(500)
  title       String?  @db.VarChar(255)
  description String?  @db.Text
  keywords    String?  @db.VarChar(255)
  ogImage     String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("seo_meta")
}

model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique @db.VarChar(500)
  to        String   @db.VarChar(500)
  type      Int      @default(301)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("redirects")
}

// ═══════════════════════════════════════════════════════════════════════════
// COMMUNITY
// ═══════════════════════════════════════════════════════════════════════════

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String?  @db.VarChar(100)
  email     String?  @db.VarChar(191)
  subject   String   @db.VarChar(255)
  message   String   @db.Text
  status    String   @default("open") @db.VarChar(20)
  reply     String?  @db.Text
  repliedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("feedbacks")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   @db.VarChar(30)
  title     String   @db.VarChar(255)
  content   String   @db.Text
  link      String?  @db.VarChar(500)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  targetType String   @db.VarChar(20)   // game|website|tool|news
  targetId   String   @db.VarChar(60)
  game       Game?    @relation(fields: [targetId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@map("favorites")
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  newsId    String
  news      News     @relation(fields: [newsId], references: [id])
  content   String   @db.Text
  likes     Int      @default(0)
  status    String   @default("active") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([newsId])
  @@index([userId])
  @@map("comments")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  newsId    String
  news      News     @relation(fields: [newsId], references: [id])
  score     Int                            // 1-5
  createdAt DateTime @default(now())

  @@unique([userId, newsId])
  @@map("ratings")
}

model Event {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  image       String?  @db.VarChar(500)
  startAt     DateTime
  endAt       DateTime
  location    String?  @db.VarChar(255)
  maxAttendees Int?
  status      String   @default("upcoming") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations EventRegistration[]

  @@index([status, startAt])
  @@map("events")
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  userId    String
  name      String   @db.VarChar(150)
  email     String   @db.VarChar(191)
  phone     String?  @db.VarChar(20)
  status    String   @default("registered") @db.VarChar(20)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_registrations")
}

model AnalyticsLog {
  id        String   @id @default(cuid())
  path      String   @db.VarChar(500)
  referer   String?  @db.VarChar(500)
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  userId    String?  @db.VarChar(60)
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([createdAt])
  @@map("analytics_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// SHARED SUPPORT & KNOWLEDGE (same pattern across all modules)
// ═══════════════════════════════════════════════════════════════════════════

model SupportRoom {
  id            String   @id @default(cuid())
  type          String   @default("private") @db.VarChar(20)
  name          String?  @db.VarChar(150)
  avatar        String?  @db.VarChar(500)
  lastMessage   String?  @db.Text
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  participants SupportParticipant[]
  messages     SupportMessage[]
  tickets      SupportTicket[]

  @@map("support_rooms")
}

model SupportParticipant {
  id         String      @id @default(cuid())
  roomId     String
  room       SupportRoom @relation(fields: [roomId], references: [id])
  userId     String      @db.VarChar(60)
  isAgent    Boolean     @default(false)
  lastReadAt DateTime    @default(now())
  joinedAt   DateTime    @default(now())
  leftAt     DateTime?
  createdAt  DateTime    @default(now())

  @@unique([roomId, userId])
  @@index([userId])
  @@map("support_participants")
}

model SupportMessage {
  id         String      @id @default(cuid())
  roomId     String
  room       SupportRoom @relation(fields: [roomId], references: [id])
  senderId   String      @db.VarChar(60)
  type       String      @default("text") @db.VarChar(20)
  content    String      @db.Text
  metadata   Json?
  isRead     Boolean     @default(false)
  readAt     DateTime?
  isDeleted  Boolean     @default(false)
  origLang   String?     @db.VarChar(10)
  translated Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([roomId, createdAt])
  @@map("support_messages")
}

model SupportTicket {
  id          String       @id @default(cuid())
  userId      String       @db.VarChar(60)
  roomId      String?
  room        SupportRoom? @relation(fields: [roomId], references: [id])
  subject     String       @db.VarChar(255)
  description String?      @db.Text
  category    String       @default("general") @db.VarChar(50)
  priority    String       @default("medium")  @db.VarChar(20)
  status      String       @default("open")    @db.VarChar(20)
  assignedTo  String?      @db.VarChar(60)
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  replies SupportTicketReply[]

  @@index([userId, status])
  @@map("support_tickets")
}

model SupportTicketReply {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id])
  senderId    String        @db.VarChar(60)
  content     String        @db.Text
  isInternal  Boolean       @default(false)
  attachments Json?
  createdAt   DateTime      @default(now())

  @@index([ticketId])
  @@map("support_ticket_replies")
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  category    String   @default("general") @db.VarChar(50)
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  content     String   @db.Text
  summary     String?  @db.Text
  image       String?  @db.VarChar(500)
  authorId    String?  @db.VarChar(60)
  views       Int      @default(0)
  likes       Int      @default(0)
  status      String   @default("published") @db.VarChar(20)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations KnowledgeTranslation[]

  @@index([category, status])
  @@map("knowledge_articles")
}

model KnowledgeTranslation {
  id        String           @id @default(cuid())
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id])
  language  String           @db.VarChar(10)
  title     String           @db.VarChar(255)
  content   String           @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([articleId, language])
  @@map("knowledge_translations")
}

model NotificationSetting {
  id        String   @id @default(cuid())
  userId    String   @unique @db.VarChar(60)
  email     Boolean  @default(true)
  push      Boolean  @default(true)
  sms       Boolean  @default(false)
  inApp     Boolean  @default(true)
  types     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_settings")
}

model TranslationLog {
  id             String   @id @default(cuid())
  sourceLang     String   @db.VarChar(10)
  targetLang     String   @db.VarChar(10)
  sourceText     String   @db.Text
  translatedText String   @db.Text
  service        String   @default("deepseek") @db.VarChar(30)
  tokenCount     Int?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("translation_logs")
}

model FileUpload {
  id           String   @id @default(cuid())
  userId       String   @db.VarChar(60)
  filename     String   @db.VarChar(255)
  originalName String   @db.VarChar(255)
  path         String   @db.VarChar(500)
  mimeType     String   @db.VarChar(100)
  size         Int
  type         String   @default("general") @db.VarChar(30)
  createdAt    DateTime @default(now())

  @@index([userId, type])
  @@map("file_uploads")
}
