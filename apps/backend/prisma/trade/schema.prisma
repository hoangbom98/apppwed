// =============================================================================
// TRADE DATABASE SCHEMA — v2.1
// Database: trade_db
// Prisma Client output: node_modules/.prisma/trade-client
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/trade-client"
}

datasource db {
  provider          = "mysql"
  url               = env("TRADE_DATABASE_URL")
  shadowDatabaseUrl = env("TRADE_SHADOW_DATABASE_URL")
}

// =============================================================================
// USER
// =============================================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique @db.VarChar(150)
  password        String    @db.VarChar(255)
  tradingPassword String?   @db.VarChar(255)  // separate 6-digit trading password (hashed)
  fullName        String?   @db.VarChar(100)
  avatar          String?   @db.VarChar(500)
  phone           String?   @db.VarChar(20)
  // user | admin
  role            String    @default("user") @db.VarChar(20)
  // pending | verified | rejected
  kycStatus       String    @default("pending") @db.VarChar(20)
  kycData         Json?
  // active | suspended | banned
  status          String    @default("active") @db.VarChar(20)
  tradingFrozen   Boolean   @default(false)    // isjy — freeze trading only
  memberLevel     Int       @default(1)        // VIP membership level 1-10
  integral        Decimal   @default(0) @db.Decimal(19, 4)  // points balance
  referralCode          String?   @unique @db.VarChar(20)         // user's own referral code
  passwordResetToken    String?   @db.VarChar(255)                // hashed reset token (SHA-256)
  passwordResetExpires  DateTime?                                  // token expiry (15 min)
  lastLogin             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  orders            Order[]
  positions         Position[]
  wallets           Wallet[]
  withdrawals       Withdrawal[]
  deposits          Deposit[]
  kyc               Kyc?
  transactions      Transaction[]
  notifications     Notification[]
  alerts            PriceAlert[]
  watchlists        Watchlist[]
  investments       Investment[]
  bankAccounts      BankAccount[]
  signinRecords     UserSignin[]
  yuebaoInvestments YuebaoInvestment[]
  miningInvestments MiningInvestment[]
  prizeRecords      PrizeRecord[]
  voucherUsages     VoucherUsage[]
  shopOrders        ShopOrder[]

  @@index([email])
  @@index([status])
  @@index([role])
  @@index([kycStatus])
  @@index([createdAt])
  @@map("users")
}

// =============================================================================
// MARKET & SYMBOL
// =============================================================================

model Market {
  id        String   @id @default(cuid())
  // US | HK | JP | UK | DE | CRYPTO | FOREX | COMMODITY
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  // stock | forex | crypto | commodity | index
  type      String   @db.VarChar(20)
  timezone  String?  @db.VarChar(50)  // e.g. America/New_York
  openTime  String?  @db.VarChar(10)  // e.g. 09:30
  closeTime String?  @db.VarChar(10)  // e.g. 16:00
  // active | closed | maintenance
  status    String   @default("active") @db.VarChar(20)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symbols   Symbol[]

  @@map("markets")
}

model Symbol {
  id               String   @id @default(cuid())
  marketId         String   @db.VarChar(30)
  market           Market   @relation(fields: [marketId], references: [id])
  // AAPL | BTCUSDT | EURUSD
  code             String   @unique @db.VarChar(30)
  name             String   @db.VarChar(100)
  baseAsset        String?  @db.VarChar(20)
  quoteAsset       String?  @db.VarChar(20)
  minQty           Decimal  @default(0) @db.Decimal(18, 8)
  maxQty           Decimal  @default(0) @db.Decimal(18, 8)
  stepSize         Decimal  @default(0) @db.Decimal(18, 8)
  tickSize         Decimal  @default(0) @db.Decimal(18, 8)
  minLeverage      Int      @default(1)
  maxLeverage      Int      @default(1)
  // active | halted | delisted
  status           String   @default("active") @db.VarChar(20)
  sortOrder        Int      @default(0)
  // JSON: { "0": [], "1": [["09:30","16:00"]], ... } — 0=Sun..6=Sat, empty=closed
  tradingSchedule  Json?
  orderFeeRate     Decimal  @default(0) @db.Decimal(8, 4)  // % fee per order
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders         Order[]
  positions      Position[]
  priceHistory   PriceHistory[]
  alerts         PriceAlert[]
  watchlistItems WatchlistItem[]
  riskConfig     RiskConfig?

  @@index([marketId, status])
  @@map("symbols")
}

// =============================================================================
// PRICE HISTORY (OHLCV candles)
// =============================================================================

model PriceHistory {
  id        String   @id @default(cuid())
  symbolId  String   @db.VarChar(30)
  symbol    Symbol   @relation(fields: [symbolId], references: [id])
  price     Decimal  @db.Decimal(18, 8)  // last/close price
  high      Decimal  @db.Decimal(18, 8)
  low       Decimal  @db.Decimal(18, 8)
  open      Decimal  @db.Decimal(18, 8)
  close     Decimal  @db.Decimal(18, 8)
  volume    Decimal  @default(0) @db.Decimal(18, 8)
  // 1m | 5m | 15m | 1h | 4h | 1d | 1w
  interval  String   @db.VarChar(10)
  timestamp DateTime
  createdAt DateTime @default(now())

  @@index([symbolId, timestamp])
  @@index([symbolId, interval, timestamp])
  @@map("price_history")
}

// =============================================================================
// ORDER
// =============================================================================

model Order {
  id          String   @id @default(cuid())
  userId      String   @db.VarChar(30)
  user        User     @relation(fields: [userId], references: [id])
  symbolId    String   @db.VarChar(30)
  symbol      Symbol   @relation(fields: [symbolId], references: [id])
  // buy | sell
  side        String   @db.VarChar(10)
  // market | limit | stop_loss | take_profit | trailing_stop
  type        String   @db.VarChar(30)
  price       Decimal   @db.Decimal(19, 8)
  quantity    Decimal   @db.Decimal(19, 8)
  executedQty Decimal   @default(0) @db.Decimal(19, 8)
  avgPrice    Decimal?  @db.Decimal(19, 8)
  stopPrice   Decimal?  @db.Decimal(19, 8)
  leverage    Int      @default(1)
  // pending | partial | filled | cancelled | expired | rejected
  status      String   @default("pending") @db.VarChar(20)
  note        String?  @db.VarChar(500)
  filledAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([symbolId, status])
  @@map("orders")
}

// =============================================================================
// POSITION
// =============================================================================

model Position {
  id           String    @id @default(cuid())
  userId       String    @db.VarChar(30)
  user         User      @relation(fields: [userId], references: [id])
  symbolId     String    @db.VarChar(30)
  symbol       Symbol    @relation(fields: [symbolId], references: [id])
  // long | short
  side         String    @db.VarChar(10)
  quantity     Decimal   @db.Decimal(18, 8)
  entryPrice   Decimal   @db.Decimal(18, 8)
  currentPrice Decimal   @db.Decimal(18, 8)
  stopLoss     Decimal?  @db.Decimal(18, 8)
  takeProfit   Decimal?  @db.Decimal(18, 8)
  pnl          Decimal   @default(0) @db.Decimal(18, 8)
  pnlPercent   Decimal   @default(0) @db.Decimal(8, 2)
  leverage     Int       @default(1)
  margin       Decimal   @default(0) @db.Decimal(18, 2)    // reserved margin
  // open | closed
  status       String    @default("open") @db.VarChar(20)
  closedPrice  Decimal?  @db.Decimal(18, 8)
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([symbolId, status])
  @@map("positions")
}

// =============================================================================
// WALLET
// =============================================================================

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id])
  balance   Decimal  @default(0) @db.Decimal(19, 4)
  frozen    Decimal  @default(0) @db.Decimal(19, 4)   // locked in open orders/positions
  version   Int      @default(0)                       // Optimistic lock — increment on every balance write
  currency  String   @default("USD") @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("wallets")
}

// =============================================================================
// WITHDRAWAL
// =============================================================================

model Withdrawal {
  id          String    @id @default(cuid())
  userId      String    @db.VarChar(30)
  user        User      @relation(fields: [userId], references: [id])
  amount      Decimal   @db.Decimal(19, 4)
  fee         Decimal   @default(0) @db.Decimal(19, 4)
  netAmount   Decimal   @db.Decimal(19, 4)
  // bank | usdt | skrill | neteller | wire
  method      String    @db.VarChar(30)
  address     String?   @db.VarChar(200)
  bankInfo    Json?
  // pending | processing | completed | failed | cancelled
  status      String    @default("pending") @db.VarChar(20)
  txId        String?   @db.VarChar(200)
  note        String?   @db.VarChar(500)
  adminNote   String?   @db.VarChar(500)
  processedBy String?   @db.VarChar(30)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("withdrawals")
}

// =============================================================================
// KYC
// =============================================================================

model Kyc {
  id         String    @id @default(cuid())
  userId     String    @unique @db.VarChar(30)
  user       User      @relation(fields: [userId], references: [id])
  fullName   String    @db.VarChar(100)
  idNumber   String    @db.VarChar(30)
  idFront    String    @db.VarChar(500)
  idBack     String    @db.VarChar(500)
  selfie     String    @db.VarChar(500)
  address    String?   @db.VarChar(500)
  // pending | approved | rejected
  status     String    @default("pending") @db.VarChar(20)
  note       String?   @db.VarChar(500)
  reviewedBy String?   @db.VarChar(30)
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("kyc")
}

// =============================================================================
// TRANSACTION (wallet ledger)
// =============================================================================

model Transaction {
  id            String   @id @default(cuid())
  userId        String   @db.VarChar(30)
  user          User     @relation(fields: [userId], references: [id])
  amount        Decimal  @db.Decimal(19, 4)
  // deposit | withdraw | trade_open | trade_close | fee | bonus | referral
  type          String   @db.VarChar(30)
  referenceId   String?  @unique @db.VarChar(30)    // Idempotency key — unique per external transaction
  referenceType String?  @db.VarChar(30)
  note          String?  @db.VarChar(500)
  balanceBefore Decimal  @default(0) @db.Decimal(19, 4)
  balanceAfter  Decimal  @db.Decimal(19, 4)
  createdAt     DateTime @default(now())

  @@index([userId, type])
  @@index([userId, createdAt])
  @@map("transactions")
}

// =============================================================================
// NOTIFICATION
// =============================================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id])
  // order_filled | kyc_update | deposit | withdraw | price_alert | system | margin_call
  type      String   @db.VarChar(30)
  title     String   @db.VarChar(255)
  content   String   @db.Text
  link      String?  @db.VarChar(500)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// =============================================================================
// PRICE ALERT (user-defined triggers)
// =============================================================================

model PriceAlert {
  id         String    @id @default(cuid())
  userId     String    @db.VarChar(30)
  user       User      @relation(fields: [userId], references: [id])
  symbolId   String    @db.VarChar(30)
  symbol     Symbol    @relation(fields: [symbolId], references: [id])
  // above | below
  condition  String    @db.VarChar(20)
  price      Decimal   @db.Decimal(18, 8)
  // active | triggered | cancelled
  status     String    @default("active") @db.VarChar(20)
  note       String?   @db.VarChar(255)
  triggeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, status])
  @@index([symbolId, status])
  @@map("price_alerts")
}

// =============================================================================
// WATCHLIST
// =============================================================================

model Watchlist {
  id        String          @id @default(cuid())
  userId    String          @db.VarChar(30)
  user      User            @relation(fields: [userId], references: [id])
  name      String          @db.VarChar(100)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  items     WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String    @id @default(cuid())
  watchlistId String    @db.VarChar(30)
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id])
  symbolId    String    @db.VarChar(30)
  symbol      Symbol    @relation(fields: [symbolId], references: [id])
  sortOrder   Int       @default(0)
  addedAt     DateTime  @default(now())

  @@unique([watchlistId, symbolId])
  @@map("watchlist_items")
}

// =============================================================================
// SHARED MODULES — Support Chat / Ticket / Knowledge / Translation / Files
// =============================================================================

model SupportRoom {
  id            String    @id @default(cuid())
  type          String    @default("private") @db.VarChar(20)
  name          String?   @db.VarChar(100)
  avatar        String?   @db.VarChar(500)
  lastMessage   String?   @db.Text
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants  SupportParticipant[]
  messages      SupportMessage[]
  tickets       SupportTicket[]

  @@map("support_rooms")
}

model SupportParticipant {
  id         String      @id @default(cuid())
  roomId     String      @db.VarChar(30)
  room       SupportRoom @relation(fields: [roomId], references: [id])
  userId     String      @db.VarChar(30)
  isAgent    Boolean     @default(false)
  lastReadAt DateTime    @default(now())
  joinedAt   DateTime    @default(now())
  leftAt     DateTime?
  createdAt  DateTime    @default(now())

  @@unique([roomId, userId])
  @@index([userId])
  @@map("support_participants")
}

model SupportMessage {
  id         String      @id @default(cuid())
  roomId     String      @db.VarChar(30)
  room       SupportRoom @relation(fields: [roomId], references: [id])
  senderId   String      @db.VarChar(30)
  type       String      @default("text") @db.VarChar(20)
  content    String      @db.Text
  metadata   Json?
  isRead     Boolean     @default(false)
  readAt     DateTime?
  isDeleted  Boolean     @default(false)
  origLang   String?     @db.VarChar(10)
  translated Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([roomId, createdAt])
  @@map("support_messages")
}

model SupportTicket {
  id          String       @id @default(cuid())
  userId      String       @db.VarChar(30)
  roomId      String?      @db.VarChar(30)
  room        SupportRoom? @relation(fields: [roomId], references: [id])
  subject     String       @db.VarChar(255)
  description String?      @db.Text
  category    String       @default("general") @db.VarChar(50)
  priority    String       @default("medium") @db.VarChar(20)
  status      String       @default("open") @db.VarChar(20)
  assignedTo  String?      @db.VarChar(30)
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  replies     SupportTicketReply[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("support_tickets")
}

model SupportTicketReply {
  id          String        @id @default(cuid())
  ticketId    String        @db.VarChar(30)
  ticket      SupportTicket @relation(fields: [ticketId], references: [id])
  senderId    String        @db.VarChar(30)
  content     String        @db.Text
  isInternal  Boolean       @default(false)
  attachments Json?
  createdAt   DateTime      @default(now())

  @@index([ticketId])
  @@map("support_ticket_replies")
}

model KnowledgeArticle {
  id          String    @id @default(cuid())
  category    String    @default("general") @db.VarChar(50)
  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  content     String    @db.LongText
  summary     String?   @db.VarChar(500)
  image       String?   @db.VarChar(500)
  authorId    String?   @db.VarChar(30)
  views       Int       @default(0)
  likes       Int       @default(0)
  status      String    @default("published") @db.VarChar(20)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  translations KnowledgeTranslation[]

  @@index([category, status])
  @@map("knowledge_articles")
}

model KnowledgeTranslation {
  id        String           @id @default(cuid())
  articleId String           @db.VarChar(30)
  article   KnowledgeArticle @relation(fields: [articleId], references: [id])
  language  String           @db.VarChar(10)
  title     String           @db.VarChar(255)
  content   String           @db.LongText
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([articleId, language])
  @@map("knowledge_translations")
}

model NotificationSetting {
  id        String   @id @default(cuid())
  userId    String   @unique @db.VarChar(30)
  email     Boolean  @default(true)
  push      Boolean  @default(true)
  sms       Boolean  @default(false)
  inApp     Boolean  @default(true)
  types     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_settings")
}

model TranslationLog {
  id             String   @id @default(cuid())
  sourceLang     String   @db.VarChar(10)
  targetLang     String   @db.VarChar(10)
  sourceText     String   @db.Text
  translatedText String   @db.Text
  service        String   @default("deepseek") @db.VarChar(50)
  tokenCount     Int?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("translation_logs")
}

model FileUpload {
  id           String   @id @default(cuid())
  userId       String   @db.VarChar(30)
  filename     String   @db.VarChar(255)
  originalName String   @db.VarChar(255)
  path         String   @db.VarChar(500)
  mimeType     String   @db.VarChar(100)
  size         Int
  type         String   @default("general") @db.VarChar(30)
  createdAt    DateTime @default(now())

  @@index([userId, type])
  @@map("file_uploads")
}

// =============================================================================
// DEPOSIT (manual deposit requests — separate from Transaction ledger)
// =============================================================================

model Deposit {
  id          String    @id @default(cuid())
  userId      String    @db.VarChar(30)
  amount      Decimal   @db.Decimal(19, 4)
  method      String    @db.VarChar(30)       // bank | usdt | momo | qr
  txHash      String?   @db.VarChar(200)       // crypto tx hash
  proof       String?   @db.VarChar(500)       // uploaded screenshot
  bankInfo    Json?                             // bank transfer details
  // pending | approved | rejected
  status      String    @default("pending") @db.VarChar(20)
  note        String?   @db.VarChar(500)
  adminNote   String?   @db.VarChar(500)
  processedBy String?   @db.VarChar(30)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("deposits")
}

// =============================================================================
// INVESTMENT PACKAGE
// =============================================================================

model InvestmentPackage {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  minAmount    Decimal  @default(0) @db.Decimal(19, 4)
  maxAmount    Decimal  @default(0) @db.Decimal(19, 4)   // 0 = unlimited
  dailyProfit  Decimal  @db.Decimal(8, 4)                // % per day
  duration     Int                                         // days
  totalSlots   Int      @default(0)                       // 0 = unlimited
  usedSlots    Int      @default(0)                       // how many sold
  perUserLimit Int      @default(0)                       // 0 = unlimited per user
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  investments  Investment[]

  @@unique([name])
  @@map("investment_packages")
}

// =============================================================================
// INVESTMENT (user purchases a package)
// =============================================================================

model Investment {
  id          String            @id @default(cuid())
  userId      String            @db.VarChar(30)
  packageId   String            @db.VarChar(30)
  amount      Decimal           @db.Decimal(19, 4)
  profitPaid  Decimal           @default(0) @db.Decimal(19, 4)
  startDate   DateTime          @default(now())
  endDate     DateTime
  lastPaidAt  DateTime?
  voucherId   String?           @db.VarChar(30)           // applied voucher
  // ACTIVE | COMPLETED | CANCELLED
  status      String            @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id])
  package     InvestmentPackage @relation(fields: [packageId], references: [id])
  schedule    InvestmentSchedule[]

  @@index([userId, status])
  @@index([status, lastPaidAt])
  @@map("investments")
}

// =============================================================================
// INVESTMENT SCHEDULE (payment installments)
// =============================================================================

model InvestmentSchedule {
  id           String     @id @default(cuid())
  investmentId String     @db.VarChar(30)
  investment   Investment @relation(fields: [investmentId], references: [id])
  dueDate      DateTime
  amount       Decimal    @db.Decimal(19, 4)
  paidAt       DateTime?
  // pending | paid | skipped
  status       String     @default("pending") @db.VarChar(20)
  createdAt    DateTime   @default(now())

  @@index([investmentId, status])
  @@index([dueDate, status])
  @@map("investment_schedules")
}

// =============================================================================
// REFERRAL (F1 / F2 chain)
// =============================================================================

model Referral {
  id         String   @id @default(cuid())
  referrerId String   @db.VarChar(30)   // the one who referred
  referredId String   @unique @db.VarChar(30)  // the new user
  level      Int      @default(1)        // 1=direct F1, 2=F2
  createdAt  DateTime @default(now())

  @@index([referrerId])
  @@index([referredId])
  @@map("referrals")
}

// =============================================================================
// COMMISSION LOG (referral earnings)
// =============================================================================

model CommissionLog {
  id         String    @id @default(cuid())
  userId     String    @db.VarChar(30)     // earner
  fromUserId String    @db.VarChar(30)     // activity source
  amount     Decimal   @db.Decimal(19, 4)
  level      Int                            // 1 or 2
  // investment | trade
  source     String    @db.VarChar(30)
  sourceId   String?   @db.VarChar(30)
  // PENDING | PAID
  status     String    @default("PENDING") @db.VarChar(20)
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  @@index([userId, status])
  @@index([fromUserId])
  @@map("commission_logs")
}

// =============================================================================
// SYSTEM CONFIG (key-value global settings — replaces lc_info)
// =============================================================================

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  // finance | trading | payment | reward | general
  group       String   @default("general") @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([group])
  @@map("system_configs")
}

// =============================================================================
// RISK CONFIG (per-symbol risk params — replaces lc_risk)
// =============================================================================

model RiskConfig {
  id             String   @id @default(cuid())
  symbolId       String   @unique @db.VarChar(30)
  symbol         Symbol   @relation(fields: [symbolId], references: [id])
  qybl           Decimal  @default(0) @db.Decimal(8, 4)   // risk rate type 3
  qkbl           Decimal  @default(0) @db.Decimal(8, 4)   // risk rate type 4
  maxPositionAmt Decimal  @default(0) @db.Decimal(18, 2)  // 0 = unlimited
  marginCallRate Decimal  @default(0.1) @db.Decimal(8, 4) // 10% margin call threshold
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("risk_configs")
}

// =============================================================================
// BANK ACCOUNT (user-saved bank/e-wallet accounts)
// =============================================================================

model BankAccount {
  id            String   @id @default(cuid())
  userId        String   @db.VarChar(30)
  user          User     @relation(fields: [userId], references: [id])
  // bank | alipay | usdt | momo | zalo
  type          String   @default("bank") @db.VarChar(20)
  bankName      String?  @db.VarChar(100)
  accountNumber String   @db.VarChar(50)
  accountName   String   @db.VarChar(100)
  branch        String?  @db.VarChar(100)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("bank_accounts")
}

// =============================================================================
// USER SIGN-IN (daily check-in reward)
// =============================================================================

model UserSignin {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id])
  date      String   @db.VarChar(10)   // YYYY-MM-DD
  reward    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@map("user_signins")
}

// =============================================================================
// YUEBAO PRODUCT (money market savings products — 余额宝)
// =============================================================================

model YuebaoProduct {
  id           String   @id @default(cuid())
  title        String   @db.VarChar(100)
  description  String?  @db.Text
  interestRate Decimal  @db.Decimal(8, 4)   // % per annum or per term
  days         Int                            // term length in days
  minAmount    Decimal  @db.Decimal(19, 4)
  maxAmount    Decimal  @default(0) @db.Decimal(19, 4)  // 0 = unlimited
  stars        Int      @default(0)           // display rating 1-5
  // active | inactive | deleted
  status       String   @default("active") @db.VarChar(20)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  investments YuebaoInvestment[]

  @@map("yuebao_products")
}

// =============================================================================
// YUEBAO INVESTMENT (user's money market holding)
// =============================================================================

model YuebaoInvestment {
  id          String        @id @default(cuid())
  userId      String        @db.VarChar(30)
  user        User          @relation(fields: [userId], references: [id])
  productId   String        @db.VarChar(30)
  product     YuebaoProduct @relation(fields: [productId], references: [id])
  amount      Decimal       @db.Decimal(19, 4)
  profitPaid  Decimal       @default(0) @db.Decimal(19, 4)
  startDate   DateTime      @default(now())
  endDate     DateTime
  settledAt   DateTime?
  // active | completed | cancelled
  status      String        @default("active") @db.VarChar(20)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, status])
  @@index([endDate, status])
  @@map("yuebao_investments")
}

// =============================================================================
// MINING MACHINE (矿机)
// =============================================================================

model MiningMachine {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(100)
  description String?  @db.Text
  image       String?  @db.VarChar(500)
  price       Decimal  @db.Decimal(19, 4)    // purchase price / deposit
  totalStock  Int      @default(0)            // 0 = unlimited
  stock       Int      @default(0)            // remaining stock
  dayIncome   Decimal  @db.Decimal(19, 4)     // daily income per unit
  cost        Decimal  @default(0) @db.Decimal(19, 4)  // daily operating cost
  duration    Int      @default(0)            // days (0 = indefinite)
  perUserLimit Int     @default(0)            // 0 = unlimited
  // active | inactive | deleted
  status      String   @default("active") @db.VarChar(20)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  investments MiningInvestment[]

  @@map("mining_machines")
}

// =============================================================================
// MINING INVESTMENT (user buys mining machine)
// =============================================================================

model MiningInvestment {
  id        String        @id @default(cuid())
  userId    String        @db.VarChar(30)
  user      User          @relation(fields: [userId], references: [id])
  machineId String        @db.VarChar(30)
  machine   MiningMachine @relation(fields: [machineId], references: [id])
  quantity  Int           @default(1)
  deposit   Decimal       @db.Decimal(19, 4)   // collateral returned on completion
  dayIncome Decimal       @db.Decimal(19, 4)   // daily income snapshot
  profitPaid Decimal      @default(0) @db.Decimal(19, 4)
  startDate DateTime      @default(now())
  endDate   DateTime?
  lastPaidAt DateTime?
  // active | completed | cancelled
  status    String        @default("active") @db.VarChar(20)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, status])
  @@index([status, lastPaidAt])
  @@map("mining_investments")
}

// =============================================================================
// VOUCHER (investment discount coupons)
// =============================================================================

model Voucher {
  id         String    @id @default(cuid())
  code       String    @unique @db.VarChar(30)
  // fixed | percent
  type       String    @default("fixed") @db.VarChar(20)
  amount     Decimal   @db.Decimal(19, 4)    // discount amount or %
  minPurchase Decimal  @default(0) @db.Decimal(19, 4)
  maxUses    Int       @default(1)
  usedCount  Int       @default(0)
  expiresAt  DateTime?
  // active | expired | disabled
  status     String    @default("active") @db.VarChar(20)
  createdAt  DateTime  @default(now())

  usages VoucherUsage[]

  @@map("vouchers")
}

model VoucherUsage {
  id          String   @id @default(cuid())
  voucherId   String   @db.VarChar(30)
  voucher     Voucher  @relation(fields: [voucherId], references: [id])
  userId      String   @db.VarChar(30)
  user        User     @relation(fields: [userId], references: [id])
  referenceId String?  @db.VarChar(30)   // investment id
  usedAt      DateTime @default(now())

  @@unique([voucherId, userId])
  @@map("voucher_usages")
}

// =============================================================================
// PRIZE DRAW (抽奖 — lucky wheel)
// =============================================================================

model PrizeConfig {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(100)
  // cash | physical | points
  type      String    @default("cash") @db.VarChar(20)
  amount    Decimal   @default(0) @db.Decimal(19, 4)
  odds      Decimal   @db.Decimal(8, 4)   // probability 0-100
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  eventId   String?   @db.VarChar(30)     // group prizes into events
  endTime   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  records PrizeRecord[]

  @@map("prize_configs")
}

model PrizeRecord {
  id        String      @id @default(cuid())
  userId    String      @db.VarChar(30)
  user      User        @relation(fields: [userId], references: [id])
  prizeId   String      @db.VarChar(30)
  prize     PrizeConfig @relation(fields: [prizeId], references: [id])
  wonAt     DateTime    @default(now())
  claimed   Boolean     @default(false)
  claimedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([wonAt])
  @@map("prize_records")
}

// =============================================================================
// BANNER / SLIDE
// =============================================================================

model Banner {
  id        String    @id @default(cuid())
  title     String?   @db.VarChar(255)
  imageUrl  String    @db.VarChar(500)
  linkUrl   String?   @db.VarChar(500)
  // top | middle | bottom
  position  String    @default("top") @db.VarChar(20)
  sortOrder Int       @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  // active | inactive
  status    String    @default("active") @db.VarChar(20)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, position])
  @@map("banners")
}

// =============================================================================
// NEWS ARTICLE
// =============================================================================

model NewsArticle {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  content     String    @db.LongText
  summary     String?   @db.VarChar(500)
  thumbnail   String?   @db.VarChar(500)
  category    String    @default("news") @db.VarChar(50)
  authorId    String?   @db.VarChar(30)
  views       Int       @default(0)
  // published | draft | hidden
  status      String    @default("published") @db.VarChar(20)
  readReward  Decimal   @default(0) @db.Decimal(19, 4)  // reward for reading
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  viewLogs NewsViewLog[]

  @@index([category, status])
  @@map("news_articles")
}

model NewsViewLog {
  id        String      @id @default(cuid())
  articleId String      @db.VarChar(30)
  article   NewsArticle @relation(fields: [articleId], references: [id])
  userId    String      @db.VarChar(30)
  reward    Decimal     @default(0) @db.Decimal(19, 4)
  viewedAt  DateTime    @default(now())

  @@unique([articleId, userId])   // one reward per article per user
  @@index([userId])
  @@map("news_view_logs")
}

// =============================================================================
// POINTS SHOP
// =============================================================================

model ShopItem {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(100)
  description String?  @db.Text
  image       String?  @db.VarChar(500)
  points      Decimal  @db.Decimal(19, 4)   // integral cost
  stock       Int      @default(0)           // 0 = unlimited
  // physical | cash | coupon
  type        String   @default("physical") @db.VarChar(20)
  cashValue   Decimal  @default(0) @db.Decimal(19, 4)  // if type=cash
  sortOrder   Int      @default(0)
  status      String   @default("active") @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders ShopOrder[]

  @@map("shop_items")
}

model ShopOrder {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(30)
  user      User     @relation(fields: [userId], references: [id])
  itemId    String   @db.VarChar(30)
  item      ShopItem @relation(fields: [itemId], references: [id])
  points    Decimal  @db.Decimal(19, 4)
  quantity  Int      @default(1)
  // pending | delivered | cancelled
  status    String   @default("pending") @db.VarChar(20)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("shop_orders")
}
