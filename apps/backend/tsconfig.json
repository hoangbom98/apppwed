{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "dist",
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "sourceMap": false,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",
    "noEmitOnError": false,
    "types": ["node"],
    "paths": {
      "@lkvip/constants": ["../packages/constants/src/index.js"],
      "@lkvip/utils":     ["../packages/shared-utils/src/index.js"]
    }
  },
  "include": ["src/**/*", "server.ts"],
  "exclude": ["node_modules", "dist", "prisma/seeds", "prisma/migrations", "src/__tests__/**/*", "**/*.test.ts", "**/*.spec.ts"]
}
