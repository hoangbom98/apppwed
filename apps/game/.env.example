# ─────────────────────────────────────────────────────────────────────────────
# .env.example — @lkvip/game (Vite + React + Capacitor)
# Copy to .env:  cp .env.example .env   then fill every value.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL of the backend API + Socket.IO server.
# Used by vite.config.ts proxy target (process.env.VITE_API_URL).
VITE_API_URL=http://localhost:5000

# ── Capacitor ─────────────────────────────────────────────────────────────────
# Set to 'true' only when building for native iOS/Android via `cap:build`.
# CAPACITOR_BUILD=true

# ── Application ───────────────────────────────────────────────────────────────
VITE_APP_NAME=LKVIP Game
VITE_APP_ENV=development
