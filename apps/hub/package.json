{
  "name": "@lkvip/hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "cap:build": "cross-env CAPACITOR_BUILD=true tsc -b && cross-env CAPACITOR_BUILD=true vite build",
    "cap:sync": "npm run cap:build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:run:android": "npm run cap:build && npx cap run android",
    "cap:run:ios": "npm run cap:build && npx cap run ios",
    "cap:live:android": "npx cap run android --livereload --external"
  },
  "dependencies": {
    "@lkvip/ui": "workspace:*",
    "@lkvip/types": "workspace:*",
    "@capacitor/android": "catalog:",
    "@capacitor/app": "catalog:",
    "@capacitor/core": "catalog:",
    "@capacitor/haptics": "catalog:",
    "@capacitor/ios": "catalog:",
    "@capacitor/keyboard": "catalog:",
    "@capacitor/network": "catalog:",
    "@capacitor/push-notifications": "catalog:",
    "@capacitor/splash-screen": "catalog:",
    "@capacitor/status-bar": "catalog:",
    "@tanstack/react-query": "catalog:",
    "axios": "catalog:",
    "dompurify": "^3.2.6",
    "i18next": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-helmet-async": "catalog:",
    "react-hot-toast": "catalog:",
    "react-i18next": "catalog:",
    "react-router-dom": "catalog:",
    "socket.io-client": "catalog:",
    "yup": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@capacitor/cli": "catalog:",
    "@types/dompurify": "^3.0.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "autoprefixer": "catalog:",
    "cross-env": "catalog:",
    "oxlint": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0",
    "@tailwindcss/vite": "catalog:"
  }
}