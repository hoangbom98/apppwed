{
  "name": "@lkvip/hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src --config ../../oxlint.config.json",
    "lint:fix": "oxlint src --config ../../oxlint.config.json --fix",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "cap:build": "cross-env CAPACITOR_BUILD=true tsc -b && cross-env CAPACITOR_BUILD=true vite build",
    "cap:sync": "npm run cap:build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:run:android": "npm run cap:build && npx cap run android",
    "cap:run:ios": "npm run cap:build && npx cap run ios",
    "cap:live:android": "npx cap run android --livereload --external"
  },
  "dependencies": {
    "@capacitor/android": "*",
    "@capacitor/app": "*",
    "@capacitor/core": "*",
    "@capacitor/haptics": "*",
    "@capacitor/ios": "*",
    "@capacitor/keyboard": "*",
    "@capacitor/network": "*",
    "@capacitor/push-notifications": "*",
    "@capacitor/splash-screen": "*",
    "@capacitor/status-bar": "*",
    "@lkvip/types": "workspace:*",
    "@lkvip/ui": "workspace:*",
    "@tanstack/react-query": "*",
    "axios": "*",
    "dompurify": "^3.2.6",
    "i18next": "*",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "react-helmet-async": "*",
    "react-hot-toast": "*",
    "react-i18next": "*",
    "react-router-dom": "*",
    "socket.io-client": "*",
    "yup": "*",
    "zustand": "*"
  },
  "devDependencies": {
    "@capacitor/cli": "*",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "*",
    "@types/dompurify": "^3.0.5",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "*",
    "autoprefixer": "*",
    "cross-env": "*",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "oxlint": "*",
    "vitest": "*",
    "@testing-library/jest-dom": "*",
    "postcss": "*",
    "tailwindcss": "*",
    "typescript": "*",
    "vite": "*",
    "vite-plugin-pwa": "^1.3.0"
  }
}