# ─────────────────────────────────────────────────────────────────────────────
# .env.example — @lkvip/landing (Vite + React SPA)
# Copy to .env:  cp .env.example .env   then fill every value.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# URL backend API — landing/server (Node + Express)
# Dev  : http://localhost:5000
# Prod : https://api.omnisrealty.com  (hoặc domain riêng)
VITE_API_BASE_URL=http://localhost:5000

# Tên ứng dụng
VITE_APP_NAME=Omnis Properties
VITE_APP_ENV=development
