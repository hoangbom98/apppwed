# ─────────────────────────────────────────────────────────────────────────────
# .env.example — @lkvip/store (Next.js 15 E-Commerce)
# Copy to .env.local:  cp .env.example .env.local   then fill every value.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
# URL of the backend API server (used by next.config.ts rewrites).
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3012

# ── Production (VPS / PM2) — set via start-store.sh or PM2 env ───────────────
# PORT=3012
# HOSTNAME=127.0.0.1
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=https://api.tc-gaming.live
# NEXT_PUBLIC_APP_URL=https://store.tc-gaming.live
