# ─────────────────────────────────────────────────────────────────────────────
# .env.example — lkvipgroup-portal
# Copy to .env:  cp .env.example .env   then fill every value below.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (actual deploy uses FORTRESS_DATABASE_URL — see start-portal.sh) ─
# Portal uses PostgreSQL via Prisma (Supabase cloud in production)
FORTRESS_DATABASE_URL=postgresql://user:password@localhost/fortress_db?schema=public

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=CHANGE_ME_at_least_32_random_chars
BETTER_AUTH_URL=http://localhost:3000

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Get values from: https://cloudinary.com/console → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Analytics ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# ── Admin fallback credentials ────────────────────────────────────────────────
# Change these before first deployment.
ADMIN_EMAIL=admin@tc-gaming.live
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_PASSWORD=CHANGE_ME_secure_password

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
