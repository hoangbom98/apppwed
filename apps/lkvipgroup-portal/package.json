{
  "name": "@lkvip/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:seed": "dotenv -e .env -- ts-node --project tsconfig.json scripts/seed.ts"
  },
  "dependencies": {
    "@lkvip/types": "workspace:*",
    "@lkvip/ui": "workspace:*",
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.1.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@lkvip/config": "workspace:*",
    "@tailwindcss/postcss": "4.1.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.23",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "9.27.0",
    "prisma": "^6.3.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "vite": "^6.0.0"
  }
}
