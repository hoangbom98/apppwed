# ============================================================
# .gitignore — apps/mobile-native (Android Kotlin)
# ============================================================

# --- Gradle build outputs ---
.gradle/
build/
app/build/
**/build/

# --- Local config (contains SDK path — machine-specific) ---
local.properties

# --- Android Studio / IntelliJ ---
.idea/
*.iml
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/.name
.idea/compiler.xml
.idea/gradle.xml
.idea/migrations/
.idea/deploymentTargetDropDown.xml
.idea/render.experimental.xml

# --- Keystore files (signing) — NEVER commit ---
*.jks
*.keystore
keystore.properties

# --- Crash / profiling ---
captures/
.externalNativeBuild/
.cxx/
*.hprof

# --- OS ---
.DS_Store
Thumbs.db

# --- Generated ---
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json
