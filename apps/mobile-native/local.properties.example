## local.properties.example
## Copy to local.properties and fill in values.
## NEVER commit local.properties — it is in .gitignore.

# Path to your Android SDK installation
# Windows: sdk.dir=C\:\\Users\\YourName\\AppData\\Local\\Android\\Sdk
# macOS:   sdk.dir=/Users/YourName/Library/Android/sdk
# Linux:   sdk.dir=/home/YourName/Android/Sdk
sdk.dir=/path/to/Android/Sdk

# Override API URL for local dev (optional)
# LKVIP_API_URL=http://10.0.2.2:5000/api
