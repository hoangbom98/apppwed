# ─────────────────────────────────────────────────────────────────────────────
# .env.example — @lkvip/mobile (Capacitor 7 wrapper)
# This app wraps one of 6 SPA targets selected by MOBILE_TARGET at build time.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Build target ──────────────────────────────────────────────────────────────
# Required. Selects which SPA is wrapped into the native shell.
# Valid values: admin | hub | game | trading | dating | sports
MOBILE_TARGET=hub

# ── Live reload (development only) ───────────────────────────────────────────
# Uncomment and set to your LAN IP when using `npx cap serve` with livereload.
# MOBILE_DEV_URL=http://192.168.x.x:5173
