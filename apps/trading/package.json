{
  "name": "@lkvip/trade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint src --config ../../oxlint.config.json",
    "lint:fix": "oxlint src --config ../../oxlint.config.json --fix",
    "typecheck": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "cap:build": "cross-env CAPACITOR_BUILD=true tsc -b && cross-env CAPACITOR_BUILD=true vite build",
    "cap:sync": "npm run cap:build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:run:android": "npm run cap:build && npx cap run android",
    "cap:run:ios": "npm run cap:build && npx cap run ios",
    "cap:live:android": "npx cap run android --livereload --external"
  },
  "dependencies": {
    "@lkvip/constants": "workspace:*",
    "@lkvip/types": "workspace:*",
    "@lkvip/ui": "workspace:*",
    "@tanstack/react-query": "*",
    "axios": "*",
    "lucide-react": "*",
    "react": "*",
    "react-dom": "*",
    "react-hot-toast": "*",
    "react-router-dom": "*",
    "socket.io-client": "*",
    "recharts": "*",
    "zustand": "*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@vitejs/plugin-react": "*",
    "autoprefixer": "*",
    "cross-env": "*",
    "oxlint": "*",
    "vitest": "*",
    "@testing-library/jest-dom": "*",
    "postcss": "*",
    "tailwindcss": "*",
    "typescript": "*",
    "vite": "*",
    "vite-plugin-pwa": "^1.3.0"
  }
}