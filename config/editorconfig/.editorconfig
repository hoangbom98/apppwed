root = true

[*]
indent_style              = space
indent_size               = 2
end_of_line               = lf
charset                   = utf-8
trim_trailing_whitespace  = true
insert_final_newline      = true

[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.prisma]
indent_size = 2

[*.{html,svelte,vue}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{py,rb}]
indent_size = 4

[Makefile]
indent_style = tab
