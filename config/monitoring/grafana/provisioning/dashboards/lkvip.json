{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "LKVIP GROUP — API & Infrastructure Monitoring",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "API Status",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"lkvip-backend\"}", "legendFormat": "Backend" }],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Process Uptime",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "lkvip_process_uptime_seconds", "legendFormat": "Uptime (s)" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "unit": "s" },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Total Requests",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "lkvip_requests_total", "legendFormat": "Requests" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Total Errors",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "lkvip_errors_total", "legendFormat": "Errors" }],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 }] }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Cache Hit Rate",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{
        "expr": "lkvip_cache_hits_total / (lkvip_cache_hits_total + lkvip_cache_misses_total) * 100",
        "legendFormat": "Hit Rate %"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "unit": "percent",
        "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 }] }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 6,
      "type": "stat",
      "title": "RSS Memory",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "expr": "lkvip_memory_rss_bytes", "legendFormat": "RSS" }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "unit": "bytes",
        "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 209715200 }, { "color": "red", "value": 367001600 }] }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Request Rate (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "rate(lkvip_requests_total[1m])", "legendFormat": "req/s" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "Error Rate (errors/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "rate(lkvip_errors_total[1m])", "legendFormat": "errors/s" }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "fixedColor": "red", "mode": "fixed" },
          "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 0.1 }] }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Memory Usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "lkvip_memory_rss_bytes",        "legendFormat": "RSS" },
        { "expr": "lkvip_memory_heap_used_bytes",   "legendFormat": "Heap Used" },
        { "expr": "lkvip_memory_heap_total_bytes",  "legendFormat": "Heap Total" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "Heap Utilisation %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{
        "expr": "lkvip_memory_heap_used_bytes / lkvip_memory_heap_total_bytes * 100",
        "legendFormat": "Heap Used %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Cache — Hits vs Misses",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "rate(lkvip_cache_hits_total[1m])",   "legendFormat": "Hits/s" },
        { "expr": "rate(lkvip_cache_misses_total[1m])", "legendFormat": "Misses/s" },
        { "expr": "rate(lkvip_cache_errors_total[1m])", "legendFormat": "Errors/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 31,
      "type": "bargauge",
      "title": "Database Query Latency (ms)",
      "description": "Last SELECT 1 round-trip latency per database. -1 = unreachable.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{
        "expr": "lkvip_db_query_latency_ms",
        "legendFormat": "{{database}}"
      }],
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "valueMode": "color",
        "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] }
      },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 40,
      "type": "timeseries",
      "title": "CPU Usage %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [{
        "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
        "legendFormat": "CPU %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },

    {
      "id": 41,
      "type": "timeseries",
      "title": "Disk Free %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [{
        "expr": "(node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
        "legendFormat": "Disk Free %"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 15 }, { "color": "green", "value": 30 }] }
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["lkvip", "api", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "LKVIP GROUP — API & Infrastructure",
  "uid": "lkvip-main-dashboard",
  "version": 1
}
