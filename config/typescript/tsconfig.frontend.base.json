{
  /**
   * tsconfig.frontend.base.json — LKVIP GROUP
   * ─────────────────────────────────────────────────────────────────────────
   * Base TypeScript config dùng chung cho tất cả React SPA (apps/hub, apps/game,
   * apps/trading, apps/dating, apps/sports, apps/admin-dashboard).
   *
   * Mỗi SPA extend từ file này và chỉ khai báo thêm:
   *   - paths / baseUrl  (alias @/ → src/)
   *   - typeRoots / types (nếu cần thêm type package riêng)
   *   - include / references (file scope)
   *
   * KHÔNG dùng cho: backend, shared-types, @lkvip/cli
   * Các package đó extend tsconfig.base.json
   * ─────────────────────────────────────────────────────────────────────────
   */
  "compilerOptions": {
    "target":                     "ES2020",
    "useDefineForClassFields":    true,
    "lib":                        ["ES2020", "DOM", "DOM.Iterable"],
    "module":                     "ESNext",
    "moduleResolution":           "bundler",

    "ignoreDeprecations":         "6.0",

    "jsx":                        "react-jsx",
    "noEmit":                     true,
    "isolatedModules":            true,
    "moduleDetection":            "force",

    "allowImportingTsExtensions": true,
    "resolveJsonModule":          true,
    "skipLibCheck":               true,

    "strict":                     true,
    "noUnusedLocals":             false,
    "noUnusedParameters":         false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny":              true,

    "allowJs":                    false,
    "checkJs":                    false
  },
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
