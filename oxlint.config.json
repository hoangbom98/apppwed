{
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always"],
    "no-console": "warn",
    "no-debugger": "error",
    "no-unused-vars": "warn",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn"
  },
  "categories": {
    "correctness": "warn",
    "react": "warn",
    "react-hooks": "error"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.d.ts"
  ]
}
