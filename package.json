{
  "name": "lkvip-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "description": "LKVIP GROUP — Multi-Service Entertainment & Technology Platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "// -- CLI (TypeScript) --------------------------------------------------": "",
    "health": "node scripts/dist/cli.js health",
    "env": "node scripts/dist/cli.js env",
    "backup": "node scripts/dist/cli.js backup",
    "deploy": "node scripts/dist/cli.js deploy",
    "setup": "node scripts/dist/cli.js prisma generate",
    "// -- Build ------------------------------------------------------------": "",
    "build:types":     "pnpm --filter @lkvip/types run build",
    "build:utils":     "pnpm --filter @lkvip/utils run build",
    "build:constants": "pnpm --filter @lkvip/constants run build",
    "build:shared":    "pnpm --filter @lkvip/types run build",
    "build:hub":       "pnpm --filter @lkvip/hub run build",
    "build:game":      "pnpm --filter @lkvip/game run build",
    "build:admin":     "pnpm --filter @lkvip/admin run build",
    "build:dating":    "pnpm --filter @lkvip/dating run build",
    "build:trade":     "pnpm --filter @lkvip/trade run build",
    "build:sports":    "pnpm --filter @lkvip/sports run build",
    "build:packages":  "pnpm run build:types && pnpm run build:constants && pnpm run build:utils",
    "build:frontends": "pnpm --filter @lkvip/hub --filter @lkvip/game --filter @lkvip/admin --filter @lkvip/dating --filter @lkvip/trade --filter @lkvip/sports run build",
    "build:all":       "pnpm run build:packages && pnpm run build:frontends",
    "build:pwa":       "pnpm --filter @lkvip/admin run build",
    "// -- Dev -------------------------------------------------------------": "",
    "dev:backend": "pnpm --filter lkvip-backend run dev",
    "dev:hub": "pnpm --filter @lkvip/hub run dev",
    "dev:game": "pnpm --filter @lkvip/game run dev",
    "dev:admin": "pnpm --filter @lkvip/admin run dev",
    "dev:dating": "pnpm --filter @lkvip/dating run dev",
    "dev:trade": "pnpm --filter @lkvip/trade run dev",
    "dev:sports": "pnpm --filter @lkvip/sports run dev",
    "dev:all": "concurrently --kill-others-on-fail --prefix-colors \"cyan,green,yellow,magenta,blue,white,red\" \"pnpm run dev:backend\" \"pnpm run dev:hub\" \"pnpm run dev:game\" \"pnpm run dev:admin\" \"pnpm run dev:dating\" \"pnpm run dev:trade\" \"pnpm run dev:sports\"",
    "dev:frontend": "concurrently --kill-others-on-fail --prefix-colors \"green,yellow,magenta,blue,white,red\" \"pnpm run dev:hub\" \"pnpm run dev:game\" \"pnpm run dev:admin\" \"pnpm run dev:dating\" \"pnpm run dev:trade\" \"pnpm run dev:sports\"",
    "// -- Install ----------------------------------------------------------": "",
    "install:all": "pnpm install",
    "// -- Prisma (workspace-level shortcuts) -------------------------------": "",
    "prisma:generate": "pnpm --filter lkvip-backend run prisma:generate",
    "prisma:deploy": "pnpm --filter lkvip-backend run prisma:deploy:all",
    "prisma:status": "pnpm --filter lkvip-backend run prisma:status:all",
    "// -- Lint -------------------------------------------------------------": "",
    "lint:backend": "pnpm --filter lkvip-backend run lint",
    "lint:frontend": "pnpm --filter @lkvip/hub --filter @lkvip/game --filter @lkvip/admin --filter @lkvip/dating --filter @lkvip/trade --filter @lkvip/sports --filter @lkvip/ui run lint",
    "lint:all": "pnpm -r run lint",
    "// -- TypeCheck --------------------------------------------------------": "",
    "typecheck:backend": "pnpm --filter lkvip-backend run type-check",
    "typecheck:frontend": "pnpm --filter @lkvip/hub --filter @lkvip/game --filter @lkvip/admin --filter @lkvip/dating --filter @lkvip/trade --filter @lkvip/sports run typecheck",
    "typecheck:all": "pnpm -r run typecheck",
    "// -- Test -------------------------------------------------------------": "",
    "test": "pnpm --filter lkvip-backend run test",
    "test:all": "pnpm -r run test --if-present",
    "// -- PWA (build tất cả 6 SPA dưới dạng PWA) -------------------------": "",
    "build:pwa:hub":     "pnpm --filter @lkvip/hub run build",
    "build:pwa:game":    "pnpm --filter @lkvip/game run build",
    "build:pwa:dating":  "pnpm --filter @lkvip/dating run build",
    "build:pwa:trade":   "pnpm --filter @lkvip/trade run build",
    "build:pwa:sports":  "pnpm --filter @lkvip/sports run build",
    "build:pwa:admin":   "pnpm --filter @lkvip/admin run build",
    "build:pwa:all":     "pnpm --filter @lkvip/hub --filter @lkvip/game --filter @lkvip/dating --filter @lkvip/trade --filter @lkvip/sports --filter @lkvip/admin run build",
    "// -- Mobile (Capacitor) ----------------------------------------------": "",
    "build:mobile": "pnpm --filter @lkvip/mobile run build",
    "mobile:sync": "pnpm --filter @lkvip/mobile run sync",
    "mobile:open:ios": "pnpm --filter @lkvip/mobile run open:ios",
    "mobile:open:android": "pnpm --filter @lkvip/mobile run open:android",
    "mobile:run:ios": "pnpm --filter @lkvip/mobile run run:ios",
    "mobile:run:android": "pnpm --filter @lkvip/mobile run run:android",
    "cap:build:all": "node scripts/dist/cli.js build mobile",
    "cap:build:hub": "node scripts/dist/cli.js build mobile hub",
    "cap:build:game": "node scripts/dist/cli.js build mobile game",
    "cap:build:dating": "node scripts/dist/cli.js build mobile dating",
    "// -- CLI build --------------------------------------------------------": "",
    "cli:build": "pnpm --filter @lkvip/cli run build",
    "cli:dev": "pnpm --filter @lkvip/cli run dev",
    "// -- Turbo ----------------------------------------------------------": "",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "turbo": "^2.0.0",
    "typescript": "~6.0.2"
  }
}
