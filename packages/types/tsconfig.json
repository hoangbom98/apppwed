{
  "extends": "../../config/typescript/tsconfig.base.json",
  "compilerOptions": {
    "outDir":         "./dist",
    "rootDir":        "./src",
    "module":         "ESNext",
    "target":         "ES2022",
    "lib":            ["ES2022"],
    "declaration":    true,
    "declarationMap": true,
    "sourceMap":      true,
    "strict":         true,
    "allowJs":        false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
