{
  "name": "@lkvip/ui",
  "version": "1.0.0",
  "private": true,
  "description": "LKVIP shared UI components, hooks, PWA utilities and stores. Source-direct — no build step required.",
  "main": "./index.ts",
  "exports": {
    ".":                      "./index.ts",
    "./pwa/install":          "./src/pwa/install.tsx",
    "./pwa/update":           "./src/pwa/update.tsx",
    "./pwa/autoComplete/*":   "./src/pwa/autoComplete/*.tsx",
    "./components/*":         "./components/*.tsx",
    "./hooks/*":              "./hooks/*.ts",
    "./stores/*":             "./stores/*.ts",
    "./api/*":                "./api/*.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@lkvip/constants":           "workspace:*",
    "@hookform/resolvers":         "^3.9.0",
    "antd-style":                  "^4.1.0",
    "react-hook-form":             "^7.54.0",
    "react-intersection-observer": "^9.5.3",
    "socket.io-client":            "^4.8.3",
    "yup":                         "^1.4.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "antd":                  ">=5.0.0",
    "axios":                 ">=1.0.0",
    "react":                 ">=18.0.0",
    "react-dom":             ">=18.0.0",
    "zustand":               ">=4.0.0"
  },
  "devDependencies": {
    "@capacitor/app":        "^7.0.0",
    "@capacitor/core":       "^7.0.0",
    "@capacitor/haptics":    "^7.0.0",
    "@capacitor/network":    "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@eslint/js":            "^9.9.0",
    "@sentry/react":         "^8.0.0",
    "@types/react":          "^19.0.0",
    "@types/react-dom":      "^19.0.0",
    "antd":                  "^6.5.1",
    "eslint":                "^9.9.0",
    "vite":                  "^8.1.1"
  },
  "keywords": ["react", "components", "pwa", "lkvip"],
  "license": "UNLICENSED"
}
