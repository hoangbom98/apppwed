{
  "name": "@lkvip/utils",
  "version": "1.0.0",
  "private": true,
  "description": "LKVIP shared utilities — slug, string helpers, validators, date formatters, crypto (Node.js + browser)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.js",
      "types":   "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build":     "tsc",
    "dev":       "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint":      "eslint src"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": ["lkvip", "utils", "backend", "shared"],
  "license": "UNLICENSED",
  "dependencies": {
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint":      "^10.7.0",
    "typescript":  "~6.0.2"
  }
}
