{
  "extends": "../../config/typescript/tsconfig.base.json",
  "compilerOptions": {
    "outDir":       "./dist",
    "rootDir":      "./src",
    "module":       "Node16",
    "moduleResolution": "Node16",
    "target":       "ES2022",
    "lib":          ["ES2022", "DOM"],
    "declaration":  true,
    "declarationMap": true,
    "sourceMap":    true,
    "strict":       true,
    "allowJs":      false,
    "types":        ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
