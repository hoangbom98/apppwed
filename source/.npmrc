# KJC Platform — pnpm configuration
#
# node-linker=hoisted: lay out node_modules flat (like npm) so Capacitor native
# builds (Android/iOS Gradle + Xcode) can traverse the tree without symlink issues.
node-linker=hoisted

# Content-addressed store location (outside source/ to avoid git tracking)
store-dir=../.pnpm-store

# Prevent accidental npm/yarn installs in this workspace
engine-strict=false
