# ─────────────────────────────────────────────────────────────────────────────
# .env.example — LKVIP GROUP Backend (VPS Production)
# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env:  cp .env.example .env
# Then fill in all values before running first-deploy.sh
#
# All services run locally on the VPS:
#   MySQL  → localhost:3306  (installed by setup.sh)
#   Redis  → localhost:6379  (installed by setup.sh)
#   Nginx  → port 80/443     (installed by setup.sh)
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=info
APP_NAME=LKVIP-GROUP
# Your API subdomain (used for webhook URLs, email links, etc.)
APP_URL=https://api.yourdomain.com

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_run_node_crypto_randomBytes_48_hex
JWT_REFRESH_SECRET=CHANGE_ME_run_node_crypto_randomBytes_48_hex_different
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS — list all frontend subdomains ───────────────────────────────────────
CORS_ORIGINS=https://hub.yourdomain.com,https://game.yourdomain.com,https://trade.yourdomain.com,https://dating.yourdomain.com,https://sports.yourdomain.com,https://admin.yourdomain.com

# ── Metrics endpoint protection ───────────────────────────────────────────────
# Protect /metrics (Prometheus scrape) with an API key.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Set in Prometheus scrape config: bearer_token or params: [key: [value]]
# Leave empty to allow public access (not recommended for production).
METRICS_API_KEY=CHANGE_ME_48_random_hex_chars

# ── Error tracking (Sentry) ───────────────────────────────────────────────────
# Optional: create free project at https://sentry.io
# Set to enable real-time error tracking and performance monitoring
SENTRY_DSN=

# ─────────────────────────────────────────────────────────────────────────────
# DATABASES — local MySQL 8 (setup.sh creates these)
# Credentials auto-generated by setup.sh → saved in CREDENTIALS.txt
#
# Connection pool sizing formula:
#   connection_limit = floor( (max_connections * 0.8) / (pm2_instances * 6) )
#
# VPS cores → pool size per DB (assuming MySQL max_connections=500):
#   2 cores  (2 workers)  → ?connection_limit=33
#   4 cores  (4 workers)  → ?connection_limit=16
#   8 cores  (8 workers)  → ?connection_limit=8   ← recommended
#   16 cores (16 workers) → ?connection_limit=4
#
# Example for 8-core VPS (8 PM2 workers × 6 DBs × 8 = 384 < 500*0.8=400):
# ─────────────────────────────────────────────────────────────────────────────
HUB_DATABASE_URL=mysql://lkvip_db:CHANGE_ME@127.0.0.1:3306/hub_db?connection_limit=8
GAME_DATABASE_URL=mysql://lkvip_db:CHANGE_ME@127.0.0.1:3306/game_db?connection_limit=8
TRADE_DATABASE_URL=mysql://lkvip_db:CHANGE_ME@127.0.0.1:3306/trade_db?connection_limit=8
DATING_DATABASE_URL=mysql://lkvip_db:CHANGE_ME@127.0.0.1:3306/dating_db?connection_limit=8
SPORTS_DATABASE_URL=mysql://lkvip_db:CHANGE_ME@127.0.0.1:3306/sports_db?connection_limit=8
ADMIN_DATABASE_URL=mysql://lkvip_db:CHANGE_ME@127.0.0.1:3306/admin_db?connection_limit=8

# ── Redis — local Redis 7 ─────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
CDN_BASE_URL=https://api.yourdomain.com/uploads
# Storage provider: 'local' (default) or 's3' (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=local
# Required when STORAGE_PROVIDER=s3:
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: custom S3 endpoint (Cloudflare R2, MinIO, etc.)
S3_ENDPOINT=

# ── Email (Gmail App Password) ────────────────────────────────────────────────
# Enable App Passwords: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM=noreply@lkvip.com

# ── SMS ───────────────────────────────────────────────────────────────────────
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── AI Services ───────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_TRANSLATE_KEY=

# ── WebRTC / TURN ─────────────────────────────────────────────────────────────
TURN_SERVER=turn:yourdomain.com:3478
TURN_USER=turnuser
TURN_CRED=CHANGE_ME

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars
OTP_EXPIRE_MINUTES=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── Backup (used by backup.sh cron) ───────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=lkvip_db
DB_PASSWORD=CHANGE_ME

# ── Admin seed defaults ───────────────────────────────────────────────────────
ADMIN_DEFAULT_EMAIL=admin@lkvip.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_strong_password

# ─────────────────────────────────────────────────────────────────────────────
# PAYMENT GATEWAYS (Vietnam)
# ─────────────────────────────────────────────────────────────────────────────

# ── MoMo ─────────────────────────────────────────────────────────────────────
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://api.yourdomain.com/payment/momo/return
MOMO_IPN_URL=https://api.yourdomain.com/api/lkvip/webhooks/momo

# ── ZaloPay ───────────────────────────────────────────────────────────────────
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_REDIRECT_URL=https://api.yourdomain.com/payment/zalopay/return

# ── VNPay ─────────────────────────────────────────────────────────────────────
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# GAME PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────
GSC_API_KEY=
GSC_SECRET_KEY=
GSC_BASE_URL=https://api.gscplus.com
GSC_LOBBY_URL=https://game.yourdomain.com
GSC_DEPOSIT_URL=https://game.yourdomain.com/wallet
GSC_LANGUAGE=vi
GSC_CURRENCY=VND

GOLDGATE_CLIENT_ID=
GOLDGATE_CLIENT_SECRET=
GOLDGATE_BASE_URL=https://api.goldgate.io
GOLDGATE_LOBBY_URL=https://game.yourdomain.com

TCGAMING_MERCHANT_CODE=
TCGAMING_DES_KEY=
TCGAMING_HASH_KEY=
TCGAMING_API_URL=https://api.tcgaming.net
TCGAMING_CURRENCY=VND2
TCGAMING_WALLET_TYPE=transfer

# ── Internal LKvip ────────────────────────────────────────────────────────────
LKVIP_WEBHOOK_SECRET=CHANGE_ME_32_random_chars

# ── VietQR ────────────────────────────────────────────────────────────────────
VIETQR_CLIENT_ID=
VIETQR_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_AI=false
ENABLE_2FA=false
ENABLE_QUEUE=false
MAINTENANCE_MODE=false

# ── Web Push / PWA ────────────────────────────────────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
# Then set VAPID_SUBJECT to a mailto: or https: URL for your domain
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com
# Set to true to enable real-time price feed cron (requires COINGECKO_API_URL + ALPHA_VANTAGE_API_KEY)
ENABLE_PRICE_FEED=false

# ── Trade: Price Feed ─────────────────────────────────────────────────────────
# CoinGecko public API (no key required for basic plan)
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# Alpha Vantage API key — free at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── Sports: External Score Provider (optional — stub used when not set) ────────
# Football-Data.org API — free tier at https://www.football-data.org/
FOOTBALL_DATA_API_KEY=
# Sportmonks API — https://www.sportmonks.com/
SPORTMONKS_API_TOKEN=
