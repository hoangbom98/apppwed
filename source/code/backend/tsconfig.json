{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "moduleDetection": "force",
    "paths": {
      "@lkvip/constants": ["../packages/constants/src/index.js"],
      "@lkvip/utils":     ["../packages/shared-utils/src/index.js"]
    }
  },
  "include": ["src/**/*", "server.ts", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "prisma/seeds", "prisma/migrations", "src/__tests__"]
}
