{
  "name": "@lkvip/dating",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev":          "vite",
    "build":        "tsc -b && vite build",
    "preview":      "vite preview",
    "lint":         "oxlint src",
    "typecheck":    "tsc --noEmit",
    "type-check":   "tsc --noEmit",
    "cap:build":    "cross-env CAPACITOR_BUILD=true tsc -b && cross-env CAPACITOR_BUILD=true vite build",
    "cap:sync":     "npm run cap:build && npx cap sync",
    "cap:android":  "npm run cap:sync && npx cap open android",
    "cap:ios":      "npm run cap:sync && npx cap open ios",
    "cap:run:android": "npm run cap:build && npx cap run android",
    "cap:run:ios":     "npm run cap:build && npx cap run ios",
    "cap:live:android": "npx cap run android --livereload --external"
  },
  "dependencies": {
    "@lkvip/ui":    "workspace:*",
    "@lkvip/types": "workspace:*",
    "@capacitor/android":             "^7.0.0",
    "@capacitor/app":                 "^7.0.0",
    "@capacitor/camera":              "^7.0.0",
    "@capacitor/core":                "^7.0.0",
    "@capacitor/geolocation":         "^7.0.0",
    "@capacitor/haptics":             "^7.0.0",
    "@capacitor/ios":                 "^7.0.0",
    "@capacitor/keyboard":            "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/network":             "^7.0.0",
    "@capacitor/push-notifications":  "^7.0.0",
    "@capacitor/splash-screen":       "^7.0.0",
    "@capacitor/status-bar":          "^7.0.0",
    "axios":                          "^1.18.1",
    "framer-motion":                  "^11.15.0",
    "lucide-react":                   "^0.525.0",
    "react":                          "^19.2.7",
    "react-dom":                      "^19.2.7",
    "react-hook-form":                "^7.54.0",
    "react-hot-toast":                "^2.4.1",
    "react-router-dom":               "^7.18.1",
    "socket.io-client":               "^4.7.5",
    "@tanstack/react-query":          "^5.101.2",
    "zustand":                        "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli":       "^7.0.0",
    "@types/node":          "^24.13.2",
    "oxlint":               "^1.71.0",
    "@types/react":         "^19.2.17",
    "@types/react-dom":     "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer":         "^10.5.4",
    "cross-env":            "^7.0.3",
    "postcss":              "^8.5.20",
    "tailwindcss":          "^4.3.3",
    "typescript":           "~6.0.2",
    "vite":                 "^8.1.1"
  }
}
