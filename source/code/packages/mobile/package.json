{
  "name": "@lkvip/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "LKVIP Mobile — Capacitor wrapper cho admin-dashboard PWA",
  "scripts": {
    "build": "pnpm run build:web && npx cap sync",
    "build:web": "pnpm --filter @lkvip/admin run build",
    "sync": "npx cap sync",
    "sync:ios": "npx cap sync ios",
    "sync:android": "npx cap sync android",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "add:ios": "npx cap add ios",
    "add:android": "npx cap add android",
    "run:ios": "npx cap run ios",
    "run:android": "npx cap run android",
    "dev": "npx cap serve"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/android": "^6.2.0"
  }
}
