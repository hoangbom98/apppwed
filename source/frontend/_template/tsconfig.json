{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target":     "ES2022",
    "lib":        ["ES2022", "DOM", "DOM.Iterable"],
    "module":     "ESNext",
    "moduleResolution": "bundler",
    "jsx":        "react-jsx",
    "baseUrl":    ".",
    "paths": {
      "@/*":        ["./src/*"],
      "@ui/*":      ["../shared-ui/*"],
      "@ui":        ["../shared-ui"],
      "@kjc/types": ["../../shared-types/src"]
    },
    "strict":     false,
    "noEmit":     true
  },
  "include": ["src"],
  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}
