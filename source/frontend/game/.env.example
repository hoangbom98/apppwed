VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=http://localhost:5000
VITE_APP_NAME=Game
VITE_APP_VERSION=1.0.0
VITE_PROJECT=game

# Optional: override the primary brand color at build time.
# If not set, the color is loaded dynamically from /api/shared/config?group=colors
# and applied via applyColorConfig() in KhungUngDung (AppShell).
VITE_PRIMARY_COLOR=#facf20

# Provider API keys (server-side only — do NOT expose in frontend)
# VITE_GAME_PROVIDER_KEY=  # leave empty; backend handles provider auth
# Capacitor / mobile build flag (set by build scripts, do not commit as true)
CAPACITOR_BUILD=false
