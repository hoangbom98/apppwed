{
  "name": "@kjc/hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:build": "cross-env CAPACITOR_BUILD=true tsc -b && cross-env CAPACITOR_BUILD=true vite build",
    "cap:sync": "npm run cap:build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:run:android": "npm run cap:build && npx cap run android",
    "cap:run:ios": "npm run cap:build && npx cap run ios",
    "cap:live:android": "npx cap run android --livereload --external"
  },
  "dependencies": {
    "@kjc/ui":    "*",
    "@kjc/types": "*",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@capacitor/storage": "^1.2.5",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "i18next": "^26.3.6",
    "lucide-react": "^0.525.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.1",
    "socket.io-client": "^4.8.3",
    "yup": "^1.7.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "cross-env": "^7.0.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
