{
  "name": "@lkvip/ui",
  "version": "1.0.0",
  "private": true,
  "description": "LKVIP shared UI components, hooks, PWA utilities and stores. Source-direct — no build step required.",
  "main": "./index.js",
  "exports": {
    ".":                    "./index.js",
    "./pwa/serviceWorker":  "./pwa/serviceWorker/index.ts",
    "./pwa/install":        "./pwa/install/index.ts",
    "./pwa/autoComplete":   "./pwa/autoComplete/index.ts",
    "./pwa/network":        "./pwa/network/index.ts",
    "./pwa/update":         "./pwa/update/index.ts"
  },
  "scripts": {
    "lint":       "eslint . --max-warnings 0",
    "typecheck":  "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "socket.io-client":    "^4.8.3",
    "yup":                 "^1.4.0",
    "@hookform/resolvers": "^3.9.0",
    "react-hook-form":     "^7.54.0"
  },
  "peerDependencies": {
    "react":         ">=18.0.0",
    "react-dom":     ">=18.0.0",
    "axios":         ">=1.0.0",
    "zustand":       ">=4.0.0",
    "@tanstack/react-query": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/js":       "^9.9.0",
    "@types/react":     "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@sentry/react":    "^8.0.0",
    "eslint":           "^9.9.0",
    "vite":             "^8.1.1",
    "@capacitor/core":  "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "keywords": ["react", "components", "pwa", "lkvip"],
  "license": "UNLICENSED"
}
