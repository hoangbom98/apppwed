# Ignore all uploaded files but keep folder structure
*

# Allow directory-tracking files
!.gitkeep
!.gitignore
!README.md

# Allow subdirectory .gitkeep files
!avatars/
avatars/*
!avatars/.gitkeep

!banners/
banners/*
!banners/.gitkeep

!kyc/
kyc/*
!kyc/.gitkeep

!media/
media/*
!media/.gitkeep

!tmp/
tmp/*
!tmp/.gitkeep
