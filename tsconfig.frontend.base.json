{
  /**
   * tsconfig.frontend.base.json
   * ────────────────────────────
   * Base TypeScript config dùng chung cho tất cả React SPA (frontend/*).
   * Mỗi SPA extend từ file này và chỉ khai báo thêm `paths`, `baseUrl`,
   * `typeRoots`, `types`, `include`, `references` theo nhu cầu riêng.
   *
   * KHÔNG dùng file này cho: backend, shared-types, @lkvip/cli.
   * Các dự án đó extend từ tsconfig.base.json (root).
   */
  "compilerOptions": {
    "target":                     "ES2020",
    "useDefineForClassFields":    true,
    "lib":                        ["ES2020", "DOM", "DOM.Iterable"],
    "module":                     "ESNext",
    "moduleResolution":           "bundler",
    "skipLibCheck":                true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule":          true,
    "isolatedModules":            true,
    "moduleDetection":            "force",
    "noEmit":                     true,
    "jsx":                        "react-jsx",

    "strict":               false,
    "noUnusedLocals":       false,
    "noUnusedParameters":   false,
    "noFallthroughCasesInSwitch": true,

    "allowJs":  true,
    "checkJs":  false
  }
}
